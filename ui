function UI:_uiState()
    local windows = {}
    for _, w in ipairs(self.windows) do
        windows[w.id] = {
            x = w.frame.Position.X.Offset,
            y = w.frame.Position.Y.Offset,
            open = w.open,
            visible = w.frame.Visible,
        }
    end
    return {
        theme = self.themeName,
        accent = pack(self.theme.accent),
        menuKey = pack(self.menuKey),
        visible = self.visible,
        windows = windows,
    }
end

function UI:ExportConfig()
    local paths = {}
    local locals = {}
    for _, w in ipairs(self.widgets) do
        if w.kind ~= "button" and w.kind ~= "label" and w.kind ~= "section" then
            if w.path then
                paths[w.path] = pack(w:get())
            elseif w.opt.persist then
                locals[w.id] = pack(w:get())
            end
        end
    end
    local out = {
        meta = {
            version = UI.version,
            signature = self.sig,
            title = self.title,
        },
        ui = self:_uiState(),
        values = paths,
        locals = locals,
    }
    return Http:JSONEncode(out)
end

function UI:ImportConfig(str)
    local ok, data = pcall(function()
        return Http:JSONDecode(str)
    end)
    if not ok or type(data) ~= "table" then
        return false
    end
    if data.ui then
        if data.ui.theme then
            self.themeName = data.ui.theme
            self.theme = themeOf(self.themeName)
        end
        if data.ui.accent then
            self.theme.accent = col(unpackValue(data.ui.accent), self.theme.accent)
            self.theme.accentSoft = dim(self.theme.accent, 0.45)
        end
        if data.ui.menuKey then
            self.menuKey = unpackValue(data.ui.menuKey) or self.menuKey
        end
        if data.ui.visible ~= nil then
            self.visible = data.ui.visible
            self.menuRoot.Visible = self.visible
        end
        if type(data.ui.windows) == "table" then
            for id, s in pairs(data.ui.windows) do
                local w = self.windowById[id]
                if w then
                    if s.x and s.y then
                        w.frame.Position = UDim2.fromOffset(s.x, s.y)
                    end
                    if s.open ~= nil then
                        w.open = s.open and true or false
                        w:_refresh()
                    end
                    if s.visible ~= nil then
                        w.frame.Visible = s.visible and true or false
                    end
                end
            end
        end
    end
    if type(data.values) == "table" then
        for path, value in pairs(data.values) do
            self.store:set(path, unpackValue(value), { load = true, silent = true })
        end
    end
    if type(data.locals) == "table" then
        for id, value in pairs(data.locals) do
            local w = self.widgetById[id]
            if w then
                w:set(unpackValue(value), true)
            end
        end
    end
    self:ApplyTheme()
    self:Sync()
    return true
end

function UI:_cfgFolder()
    local dir = "EasyUI4"
    if type(makefolder) == "function" then
        if type(isfolder) == "function" then
            if not isfolder(dir) then
                pcall(makefolder, dir)
            end
        else
            pcall(makefolder, dir)
        end
    end
    return dir
end

function UI:_cfgPath(name)
    return self:_cfgFolder() .. "/" .. cleanName(self.sig) .. "_" .. cleanName(name) .. ".json"
end

function UI:_autoloadPath()
    return self:_cfgFolder() .. "/autoload_" .. cleanName(self.sig) .. ".txt"
end

function UI:SaveConfig(name)
    if type(writefile) ~= "function" then
        return false
    end
    local ok, data = pcall(function()
        return self:ExportConfig()
    end)
    if not ok then
        return false
    end
    return pcall(writefile, self:_cfgPath(name), data)
end

function UI:LoadConfig(name)
    if type(isfile) ~= "function" or type(readfile) ~= "function" then
        return false
    end
    local path = self:_cfgPath(name)
    if not isfile(path) then
        return false
    end
    local ok, data = pcall(readfile, path)
    if not ok then
        return false
    end
    return self:ImportConfig(data)
end

function UI:DeleteConfig(name)
    if type(isfile) ~= "function" or type(delfile) ~= "function" then
        return false
    end
    local path = self:_cfgPath(name)
    if not isfile(path) then
        return false
    end
    return pcall(delfile, path)
end

function UI:ListConfigs()
    local out = {}
    if type(listfiles) == "function" and type(isfolder) == "function" and isfolder(self:_cfgFolder()) then
        local prefix = cleanName(self.sig) .. "_"
        local ok, files = pcall(listfiles, self:_cfgFolder())
        if ok and type(files) == "table" then
            for _, path in ipairs(files) do
                local name = path:match("([^/\\]+)%.json$")
                if name and name:sub(1, #prefix) == prefix then
                    out[#out + 1] = name:sub(#prefix + 1)
                end
            end
        end
    end
    sort(out)
    return out
end

function UI:SetAutoload(name)
    if type(writefile) ~= "function" then
        return false
    end
    if name then
        return pcall(writefile, self:_autoloadPath(), cleanName(name))
    end
    if type(isfile) == "function" and type(delfile) == "function" and isfile(self:_autoloadPath()) then
        return pcall(delfile, self:_autoloadPath())
    end
    return true
end

function UI:LoadAutoload()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then
        return false
    end
    local path = self:_autoloadPath()
    if not isfile(path) then
        return false
    end
    local ok, name = pcall(readfile, path)
    if ok and name and name ~= "" then
        return self:LoadConfig(name)
    end
    return false
end

function UI:Use(name, ...)
    local fn = Plugins[tostring(name):lower()] or Plugins[name]
    assert(fn, "plugin not found: " .. tostring(name))
    return fn(self, ...)
end

function UI:Extend(fn, ...)
    assert(type(fn) == "function", "Extend expects function")
    return fn(self, ...)
end

function UI:Destroy()
    self:_closePopup()
    self._keyWidget = nil
    if Runtime.bridge and Runtime.bridge.ui == self then
        Runtime.bridge = nil
    end
    self._espBridge = nil
    if Runtime.ui == self then
        Runtime.ui = nil
    end
    for i = #Alive, 1, -1 do
        if Alive[i] == self then
            remove(Alive, i)
        end
    end
    for i = #self.windows, 1, -1 do
        local w = self.windows[i]
        self.windows[i] = nil
        if w then
            w:Destroy()
        end
    end
    for k, ov in pairs(self.overlays) do
        self.overlays[k] = nil
        if ov then
            ov:Destroy()
        end
    end
    if self.router then
        self.router:destroy()
        self.router = nil
    end
    for i = #self.cons, 1, -1 do
        local c = self.cons[i]
        self.cons[i] = nil
        if c then
            pcall(function()
                c:Disconnect()
            end)
        end
    end
    pcall(function()
        self.gui:Destroy()
    end)
    self.widgets = {}
    self.widgetById = {}
end

function UI.DestroyAll()
    for i = #Alive, 1, -1 do
        if Alive[i] then
            Alive[i]:Destroy()
        end
    end
end

function UI.RegisterWidget(name, builder)
    assert(type(name) == "string", "widget name must be string")
    assert(type(builder) == "function", "widget builder must be function")
    Widgets[name:lower()] = builder
    return true
end

function UI.RegisterPlugin(name, fn)
    assert(type(name) == "string", "plugin name must be string")
    assert(type(fn) == "function", "plugin fn must be function")
    Plugins[name:lower()] = fn
    return true
end

function UI.GetThemes()
    local out = {}
    for k in pairs(Themes) do
        out[#out + 1] = k
    end
    sort(out)
    return out
end

function UI.GetTheme(name)
    if type(name) == "table" and name.theme ~= nil then
        return name.theme
    end
    return Themes[name]
end

function UI.AddTheme(name, palette)
    if type(name) == "string" and type(palette) == "table" then
        Themes[name] = palette
        return true
    end
    return false
end

local Toolkit = {
    Create = mk,
    Corner = corner,
    Padding = pad,
    Stroke = stroke,
    Tween = tween,
    Themes = Themes,
    PathGet = pathGet,
    PathSet = pathSet,
    PathToggle = function(tbl, path)
        return pathSet(tbl, path, not pathGet(tbl, path))
    end,
    Pack = pack,
    Unpack = unpackValue,
    ThemeOf = themeOf,
    Color = col,
    Dim = dim,
    RegisterWidget = UI.RegisterWidget,
    RegisterPlugin = UI.RegisterPlugin,
    CleanName = cleanName,
    Build = function(ui, spec) return ui:Build(spec) end,
    Overlay = function(ui, id, opt) return ui:Overlay(id, opt) end,
    Watch = function(ui, path, fn, fire) return ui:Watch(path, fn, fire) end,
    Bind = function(ui, path, value) return ui:Set(path, value) end,
    Mount = function(ui, name, root) return ui:Mount(name, root) end,
    GetWindow = function(ui, id) return ui:GetWindow(id) end,
    GetWidget = function(ui, id) return ui:GetWidget(id) end,
    GetOverlay = function(ui, id) return ui:GetOverlay(id) end,
    GetContainer = function(ui) return ui:GetContainer() end,
}

UI.Toolkit = Toolkit
return UI
