function UI:ApplyTheme()
    self.menuRoot.BackgroundTransparency = 1
    for i = 1, #self.windows do
        local w = self.windows[i]
        if w and w.frame then
            w.frame.BackgroundColor3 = self.theme.bg1
            if w.frame:FindFirstChildOfClass("UIStroke") then
                w.frame.UIStroke.Color = self.theme.line
            end
            w.header.BackgroundColor3 = self.theme.bg0
            w.title.TextColor3 = self.theme.text
            w.dot.BackgroundColor3 = self.theme.accent
            w.collapse.TextColor3 = w.open and self.theme.accent or self.theme.dim
            w.body.ScrollBarImageColor3 = self.theme.lineHi
            for ti = 1, #w.tabs do
                local tab = w.tabs[ti]
                if tab.buttonShell and tab.buttonShell:FindFirstChildOfClass("UIStroke") then
                    tab.buttonShell.BackgroundColor3 = self.theme.bg2
                    tab.buttonShell.UIStroke.Color = self.theme.line
                end
                tab.body.ScrollBarImageColor3 = self.theme.lineHi
                for si = 1, #tab.subtabs do
                    local sub = tab.subtabs[si]
                    if sub.buttonShell and sub.buttonShell:FindFirstChildOfClass("UIStroke") then
                        sub.buttonShell.BackgroundColor3 = self.theme.bg2
                        sub.buttonShell.UIStroke.Color = self.theme.line
                    end
                    sub.body.ScrollBarImageColor3 = self.theme.lineHi
                end
            end
            for j = 1, #w.widgets do
                if w.widgets[j] then
                    w.widgets[j]:applyTheme(self.theme)
                end
            end
            w:_refresh()
        end
    end
    self:_refreshWatermark()
end

