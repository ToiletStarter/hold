    end
    w:own(box.Focused:Connect(function()
        tween(shell.UIStroke, 0.1, { Color = w.ui.theme.accent })
    end))
    w:own(box.FocusLost:Connect(function(enter)
        shell.UIStroke.Color = w.ui.theme.line
        w:set(box.Text)
        safe(opt.onCommit, box.Text, enter, w)
    end))
    if w.path then
