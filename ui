function Widgets.color(win, id, opt)
    opt = opt or {}
    local row, t = makeRow(win, 24)
    label(row, opt.label or id or "Color", t, 13, UDim2.new(0, 0, 0, 0), UDim2.new(1, -100, 1, 0), row.ZIndex + 1, Enum.TextXAlignment.Left, t.text)
    local hexShell = makeField(row, t, UDim2.new(0, 60, 1, 0), UDim2.new(1, -32, 0.5, 0), Vector2.new(1, 0.5), row.ZIndex + 1)
    local hexBox = mk("TextBox", {
        Text = "",
        Font = Enum.Font.Code,
        TextSize = 11,
        TextColor3 = t.sub,
        BackgroundTransparency = 1,
        ClearTextOnFocus = false,
        Size = UDim2.new(1, 0, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Center,
        PlaceholderText = "#FFFFFF",
        PlaceholderColor3 = t.dim,
        ZIndex = hexShell.ZIndex + 1,
    }, hexShell)
    local sw = makeField(row, t, UDim2.new(0, 24, 1, 0), UDim2.new(1, 0, 0.5, 0), Vector2.new(1, 0.5), row.ZIndex + 1)
    local swBtn = buttonText(sw, "", t, 10, sw.ZIndex + 2)
    local w = Widget.new(win, id or cleanName(opt.label), "color", opt)
    w.row = row
    function w:validate(v)
        return col(v, w.value or w.ui.theme.accent)
    end
    function w:render(v)
        v = col(v, w.ui.theme.accent)
        sw.BackgroundColor3 = v
        if sw:FindFirstChildOfClass("UIStroke") then
            sw.UIStroke.Color = w.ui.theme.line
        end
        if hexShell:FindFirstChildOfClass("UIStroke") then
            hexShell.UIStroke.Color = w.ui.theme.line
        end
        hexBox.Text = hex(v)
        hexBox.TextColor3 = w.ui.theme.sub
        hexBox.PlaceholderColor3 = w.ui.theme.dim
    end
    local function open()
        local theme = w.ui.theme
        local pop = w.ui:_popup(sw, Vector2.new(172, 124))
        pop.BackgroundColor3 = theme.bg1
        corner(6, pop)
        stroke(theme.line, 1, 0, pop)
        pad(8, 8, 8, 8, pop)

        local sv = mk("Frame", {
            Size = UDim2.new(0, 124, 0, 72),
            BackgroundColor3 = w.value,
            BorderSizePixel = 0,
            ZIndex = pop.ZIndex + 1,
        }, pop)
        corner(5, sv)
        mk("UIGradient", {
            Color = ColorSequence.new(Color3.new(1, 1, 1), col(w.value, theme.accent)),
        }, sv)
        local shade = mk("Frame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.new(0, 0, 0),
            BorderSizePixel = 0,
            ZIndex = sv.ZIndex + 1,
        }, sv)
        corner(5, shade)
        mk("UIGradient", {
            Rotation = 90,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(1, 0),
            }),
        }, shade)
        local pick = mk("Frame", {
            Size = UDim2.new(0, 8, 0, 8),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = shade.ZIndex + 1,
        }, sv)
        corner(4, pick)
        stroke(Color3.new(0, 0, 0), 1, 0, pick)

        local hueBar = mk("Frame", {
            Size = UDim2.new(0, 20, 0, 72),
            Position = UDim2.new(1, -20, 0, 0),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = pop.ZIndex + 1,
        }, pop)
        corner(5, hueBar)
        mk("UIGradient", {
            Rotation = 90,
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
                ColorSequenceKeypoint.new(0.16, Color3.fromHSV(0.16, 1, 1)),
                ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
                ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
                ColorSequenceKeypoint.new(0.66, Color3.fromHSV(0.66, 1, 1)),
                ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
                ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
            }),
        }, hueBar)
        local huePick = mk("Frame", {
            Size = UDim2.new(1, 0, 0, 4),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0, 0),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            ZIndex = hueBar.ZIndex + 1,
        }, hueBar)
        stroke(Color3.new(0, 0, 0), 1, 0, huePick)

        local h, s, v = Color3.toHSV(w.value)
        local dragSV, dragHue = false, false
        local function redraw()
            local c0 = Color3.fromHSV(h, 1, 1)
            sv.BackgroundColor3 = c0
            if sv:FindFirstChildOfClass("UIGradient") then
                sv.UIGradient.Color = ColorSequence.new(Color3.new(1, 1, 1), c0)
            end
            pick.Position = UDim2.new(s, 0, 1 - v, 0)
            huePick.Position = UDim2.new(0.5, 0, h, 0)
            w:set(Color3.fromHSV(h, s, v), true)
            safe(w.onChange, w.value, w)
        end
        local function pullSV(pos)
            s = clamp((pos.X - sv.AbsolutePosition.X) / max(1, sv.AbsoluteSize.X), 0, 1)
            v = 1 - clamp((pos.Y - sv.AbsolutePosition.Y) / max(1, sv.AbsoluteSize.Y), 0, 1)
            redraw()
        end
        local function pullHue(pos)
            h = clamp((pos.Y - hueBar.AbsolutePosition.Y) / max(1, hueBar.AbsoluteSize.Y), 0, 1)
            redraw()
        end
        local function stopDrag()
            dragSV, dragHue = false, false
            w.ui.router:release(w)
        end
        sv.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragSV = true
                pullSV(input.Position)
                w.ui.router:capture(w, {
                    changed = function(i)
                        if dragSV and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                            pullSV(i.Position)
                        elseif dragHue and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                            pullHue(i.Position)
                        end
                    end,
                    ended = function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                            stopDrag()
                        end
                    end,
                })
            end
        end)
        hueBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragHue = true
                pullHue(input.Position)
                w.ui.router:capture(w, {
                    changed = function(i)
                        if dragSV and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                            pullSV(i.Position)
                        elseif dragHue and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                            pullHue(i.Position)
                        end
                    end,
                    ended = function(i)
                        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                            stopDrag()
                        end
                    end,
                })
            end
        end)
        redraw()
        w.popup = pop
    end
    w:own(swBtn.MouseButton1Click:Connect(function()
        if w.ui._popup == w.popup and w.popup then
            w.ui:_closePopup()
        else
            open()
        end
    end))
    w:own(hexBox.FocusLost:Connect(function()
        local c0 = parseHex(hexBox.Text)
        if c0 then
            w:set(c0)
        else
            w:render(w.value)
        end
    end))
    if w.path then
        if w.ui.store:get(w.path) == nil and opt.default ~= nil then
            w.ui.store:set(w.path, col(opt.default, t.accent), { init = true, silent = true })
        end
        w:sub(w.ui.store:bind(w.path, function(v, _, _, meta)
            if meta and meta.src == w then return end
            w:_apply(v)
        end, false))
        w.value = w.ui.store:get(w.path, opt.default or t.accent)
    else
        w.value = opt.default or t.accent
    end
    w:render(w.value)
    return w
end

