    stroke(t.line, 1, 0, frame)
    pad(0, 0, 8, 8, frame)
    local bar = mk("Frame", {
        Size = UDim2.new(0, 2, 1, -8),
        Position = UDim2.new(0, 4, 0, 4),
        BackgroundColor3 = t.accent,
        BorderSizePixel = 0,
