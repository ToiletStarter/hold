function UI:_front(win)
    if not win or not win.frame or not win.frame.Parent then
        return
    end
    self._top = self._top + 40
    local frame = win.frame
    local old = frame.ZIndex
    local new = self._top
    local delta = new - old
    frame.ZIndex = new
    for _, d in ipairs(frame:GetDescendants()) do
        if d:IsA("GuiObject") then
            d.ZIndex = d.ZIndex + delta
        end
    end
end

function UI:_rect(win)
    if not win or not win.frame then
        return nil
    end
    local p = win.frame.Position
    local s = win.frame.Size
    return p.X.Offset, p.Y.Offset, s.X.Offset, s.Y.Offset
end

function UI:_overlap(a, b)
    local ax, ay, aw, ah = self:_rect(a)
    local bx, by, bw, bh = self:_rect(b)
    if not ax or not bx then
        return false
    end
    return ax < bx + bw and ax + aw > bx and ay < by + bh and ay + ah > by
end

function UI:_windowAt(pos)
    local best, z = nil, -math.huge
    for i = 1, #self.windows do
        local w = self.windows[i]
        if w and w.frame and w.frame.Visible then
            local x, y, ww, hh = self:_rect(w)
            if x and pos.X >= x and pos.X <= x + ww and pos.Y >= y and pos.Y <= y + hh then
                if w.frame.ZIndex > z then
                    best = w
                    z = w.frame.ZIndex
                end
            end
        end
    end
    return best
end

function UI:_overlayAt(pos)
    local best, z = nil, -math.huge
    for _, ov in pairs(self.overlays) do
        local frame = ov and ov.frame
        if frame and frame.Visible then
            local p = frame.AbsolutePosition
            local s = frame.AbsoluteSize
            if pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y then
                if frame.ZIndex > z then
                    best = ov
                    z = frame.ZIndex
                end
            end
        end
    end
    return best
end

function UI:_watermarkAt(pos)
    local frame = self._wm
    if not frame or not frame.Visible then
        return false
    end
    local p = frame.AbsolutePosition
    local s = frame.AbsoluteSize
    return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
end

function UI:_uiHit(pos)
    if self._popup and self._popup.Parent then
        local p = self._popup.AbsolutePosition
        local s = self._popup.AbsoluteSize
        if pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y then
            return true
        end
    end
    return self:_windowAt(pos) ~= nil or self:_overlayAt(pos) ~= nil or self:_watermarkAt(pos)
end

function UI:_resolveWindow(win)
    if not win or not win.frame then
        return
    end
    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1200, 800)
    local x, y, w, h = self:_rect(win)
    x = clamp(x, 4, max(4, vp.X - w - 4))
    y = clamp(y, 4, max(4, vp.Y - h - 4))
    win.frame.Position = UDim2.fromOffset(x, y)

    local moved = true
    local passes = 0
    while moved and passes < 24 do
        moved = false
        passes = passes + 1
        for i = 1, #self.windows do
            local other = self.windows[i]
            if other and other ~= win and other.frame and other.frame.Visible and self:_overlap(win, other) then
                local ox, oy, ow, oh = self:_rect(other)
                local nx = ox + ow + 12
                local ny = y
                if nx + w > vp.X - 4 then
                    nx = 16
                    ny = oy + oh + 12
                end
                if ny + h > vp.Y - 4 then
                    ny = 54
                end
                x = clamp(nx, 4, max(4, vp.X - w - 4))
                y = clamp(ny, 4, max(4, vp.Y - h - 4))
                win.frame.Position = UDim2.fromOffset(x, y)
                moved = true
                break
            end
        end
    end
end

function UI:_resolveAll()
    sort(self.windows, function(a, b)
        return (a.frame and a.frame.ZIndex or 0) < (b.frame and b.frame.ZIndex or 0)
    end)
    for i = 1, #self.windows do
        self:_resolveWindow(self.windows[i])
    end
end

function UI:_nextPos(w)
    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1200, 800)
    if self._nextX + w + 16 > vp.X then
        self._nextX = 16
        self._nextY = self._nextY + 360
    end
    if self._nextY > vp.Y - 80 then
        self._nextY = 54
    end
    local x, y = self._nextX, self._nextY
    self._nextX = self._nextX + w + 12
    return x, y
end

