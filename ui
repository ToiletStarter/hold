function Window:Destroy()
    if self.ui._popupOwner and self.ui._popupOwner:IsDescendantOf(self.frame) then
        self.ui:_closePopup()
    end
    for i = #self.widgets, 1, -1 do
        local w = self.widgets[i]
        self.widgets[i] = nil
        if w then
            self.ui.widgetById[w.id] = nil
            for j = #self.ui.widgets, 1, -1 do
                if self.ui.widgets[j] == w then
                    remove(self.ui.widgets, j)
                end
            end
            w:destroy()
        end
    end
    for i = #self.ui.windows, 1, -1 do
        if self.ui.windows[i] == self then
            remove(self.ui.windows, i)
        end
    end
    self.ui.windowById[self.id] = nil
    pcall(function()
        self.frame:Destroy()
    end)
end

