local function parseOldArgs(kind, a, b, c, d, e)
    if kind == "toggle" then
        return cleanName(a), { label = a, default = b, onChange = c }
    elseif kind == "slider" then
        return cleanName(a), { label = a, min = b, max = c, default = d, step = e or 1 }
    elseif kind == "dropdown" then
        return cleanName(a), { label = a, items = b, default = c, onChange = d }
    elseif kind == "button" then
        return cleanName(a), { text = a, onPress = b }
    elseif kind == "keybind" then
        return cleanName(a), { label = a, default = b, onChange = c }
    elseif kind == "box" then
