    local body = mk("ScrollingFrame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 24),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self.theme.lineHi,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ClipsDescendants = true,
        ZIndex = frame.ZIndex + 1,
    }, frame)
    pad(6, 6, 6, 6, body)
    local list = mk("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 4),
    }, body)

    selfWin.frame = frame
    selfWin.header = header
    selfWin.title = titleLbl
    selfWin.dot = dot
    selfWin.collapse = collapse
    selfWin.tabBar = tabBar
    selfWin.tabList = tabList
    selfWin.subBar = subBar
    selfWin.subList = subList
    selfWin.body = body
    selfWin.list = list

    list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        selfWin:_refresh()
    end)
    collapse.MouseButton1Click:Connect(function()
        selfWin:ToggleOpen()
    end)
    collapse.MouseEnter:Connect(function()
        tween(collapse, 0.08, { TextColor3 = self.theme.accent })
    end)
    collapse.MouseLeave:Connect(function()
