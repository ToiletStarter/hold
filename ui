local function parseOldArgs(kind, a, b, c, d, e)
    if kind == "toggle" then
        return cleanName(a), { label = a, default = b, onChange = c }
    elseif kind == "slider" then
        return cleanName(a), { label = a, min = b, max = c, default = d, step = e or 1 }
    elseif kind == "dropdown" then
        return cleanName(a), { label = a, items = b, default = c, onChange = d }
    elseif kind == "button" then
        return cleanName(a), { text = a, onPress = b }
    elseif kind == "keybind" then
        return cleanName(a), { label = a, default = b, onChange = c }
    elseif kind == "box" then
        return cleanName(a), { label = a, default = b, placeholder = c, onChange = d }
    elseif kind == "color" then
        return cleanName(a), { label = a, default = b, onChange = c }
    elseif kind == "mode" then
        return cleanName(a), { label = a, items = b, default = c, onChange = d }
    elseif kind == "meter" then
        return cleanName(a), { label = a, default = b, onChange = c }
    elseif kind == "label" then
        return cleanName(a), { text = a }
    elseif kind == "section" then
        return cleanName(a), { text = a }
    end
end

function Window:_activeTarget()
    if self.activeTab then
        if self.activeTab.activeSub then
            return self.activeTab.activeSub
        end
        return self.activeTab
    end
    return self
end

function Window:_layoutTabs()
    local tabH = #self.tabs > 0 and 22 or 0
    local subH = (self.activeTab and #self.activeTab.subtabs > 0) and 20 or 0
    self.tabBar.Visible = tabH > 0
    self.subBar.Visible = subH > 0
    self.tabBar.Size = UDim2.new(1, 0, 0, tabH)
    self.subBar.Size = UDim2.new(1, 0, 0, subH)
    self.tabBar.Position = UDim2.new(0, 0, 0, 24)
    self.subBar.Position = UDim2.new(0, 0, 0, 24 + tabH)
    local y = 24 + tabH + subH

    self.body.Position = UDim2.new(0, 0, 0, y)
    for i = 1, #self.tabs do
        local tab = self.tabs[i]
        tab.body.Position = UDim2.new(0, 0, 0, y)
        for j = 1, #tab.subtabs do
            local sub = tab.subtabs[j]
            sub.body.Position = UDim2.new(0, 0, 0, y)
        end
    end
end

function Window:_refresh()
    if not self.frame or not self.frame.Parent then
        return
    end
    self:_layoutTabs()
    local active = self:_activeTarget()
    local full = (active.list and active.list.AbsoluteContentSize.Y or 0) + 12
    local show = clamp(full, 0, self.maxH)
    local tabH = #self.tabs > 0 and 22 or 0
    local subH = (self.activeTab and #self.activeTab.subtabs > 0) and 20 or 0

    self.body.Visible = active == self and self.open
    for i = 1, #self.tabs do
        local tab = self.tabs[i]
        tab.body.Visible = active == tab and self.open
        if tab.button then
            tab.button.TextColor3 = (self.activeTab == tab) and self.ui.theme.text or self.ui.theme.dim
            if tab.fill then
                tab.fill.BackgroundTransparency = (self.activeTab == tab) and 0 or 1
                tab.fill.BackgroundColor3 = self.ui.theme.accent
            end
        end
        for j = 1, #tab.subtabs do
            local sub = tab.subtabs[j]
            sub.body.Visible = active == sub and self.open
            if sub.buttonShell then
                sub.buttonShell.Visible = self.activeTab == tab
            end
            if sub.button then
                sub.button.TextColor3 = (tab.activeSub == sub) and self.ui.theme.text or self.ui.theme.dim
                if sub.fill then
                    sub.fill.BackgroundTransparency = (tab.activeSub == sub) and 0.25 or 1
                    sub.fill.BackgroundColor3 = self.ui.theme.accentSoft
                end
            end
        end
    end

    if not self.open then
        self.body.Visible = false
        self.tabBar.Visible = false
        self.subBar.Visible = false
        self.frame.Size = UDim2.new(0, self.w, 0, 24)
        self.collapse.Text = "+"
        self.collapse.TextColor3 = self.ui.theme.dim
        return
    end

    if active.body then
        active.body.Size = UDim2.new(1, 0, 0, show)
        active.body.CanvasSize = UDim2.new(0, 0, 0, full)
    end
    self.frame.Size = UDim2.new(0, self.w, 0, 24 + tabH + subH + show)
    self.collapse.Text = "–"
    self.collapse.TextColor3 = self.ui.theme.accent
    task.defer(function()
        if self.ui and self.frame and self.frame.Parent then
            self.ui:_resolveWindow(self)
        end
    end)
end

function Window:_bindDrag()
    local dragging = false
    local startPos
    local startMouse
    local dragTw
    local dragType
    local function clampPos(x, y)
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1200, 800)
        x = clamp(x, 4, max(4, vp.X - self.frame.AbsoluteSize.X - 4))
        y = clamp(y, 4, max(4, vp.Y - 24))
        return x, y
    end
    local function start(input, allow)
        if not allow then return end
        dragging = true
        dragType = input.UserInputType
        startPos = self.frame.Position
        startMouse = input.Position
        self.ui:_front(self)
        self.ui.router:capture(self, {
            changed = function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                    local d = i.Position - startMouse
                    local x, y = clampPos(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
                    if dragTw then pcall(function() dragTw:Cancel() end) end
                    dragTw = tween(self.frame, 0.08, { Position = UDim2.fromOffset(x, y) })
                end
            end,
            ended = function(i)
                if dragging and (i.UserInputType == dragType or (dragType == Enum.UserInputType.Touch and i.UserInputType == Enum.UserInputType.Touch)) then
                    dragging = false
                    if dragTw then pcall(function() dragTw:Cancel() end) end
                    local x, y = clampPos(self.frame.Position.X.Offset, self.frame.Position.Y.Offset)
                    self.frame.Position = UDim2.fromOffset(x, y)
                    self.ui:_resolveWindow(self)
                    self.ui.router:release(self)
                end
            end,
        })
    end
    self.header.InputBegan:Connect(function(input)
        start(input, input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch)
    end)
    self.frame.InputBegan:Connect(function(input)
        start(input, input.UserInputType == Enum.UserInputType.MouseButton3)
    end)
end

function Window:_add(widget)
    if self.ui.widgetById[widget.id] and self.ui.widgetById[widget.id] ~= widget then
        local base = self.id .. "." .. tostring(widget.id)
        local key = base
        local n = 2
        while self.ui.widgetById[key] do
            key = base .. tostring(n)
            n = n + 1
        end
        widget.id = key
    end
    self.widgets[#self.widgets + 1] = widget
    self.ui.widgets[#self.ui.widgets + 1] = widget
    self.ui.widgetById[widget.id] = widget
    return widget
end

local function bindTargetMethods(proto)
    function proto:Section(text)
        return self:_add(Widgets.section(self, cleanName(text), { text = text }))
    end

    function proto:Label(id, text)
        if text == nil then
            text, id = id, cleanName(id)
        end
        return self:_add(Widgets.label(self, id, { text = text }))
    end

    function proto:Button(id, text, opt)
        if type(text) == "table" then
            opt, text = text, id
        elseif type(text) == "function" then
            opt = { onPress = text, text = id }
            id = cleanName(id)
        else
            opt = opt or {}
            opt.text = text
        end
        return self:_add(Widgets.button(self, id, opt))
    end

    function proto:Toggle(id, opt)
        return self:_add(Widgets.toggle(self, id, opt or {}))
    end

    function proto:Slider(id, opt)
        return self:_add(Widgets.slider(self, id, opt or {}))
    end

    function proto:Dropdown(id, opt)
        return self:_add(Widgets.dropdown(self, id, opt or {}))
    end

    function proto:Mode(id, opt)
        return self:_add(Widgets.mode(self, id, opt or {}))
    end

    function proto:Keybind(id, opt)
        return self:_add(Widgets.keybind(self, id, opt or {}))
    end

    function proto:Box(id, opt)
        return self:_add(Widgets.box(self, id, opt or {}))
    end

    function proto:Color(id, opt)
        return self:_add(Widgets.color(self, id, opt or {}))
    end

    function proto:Meter(id, opt)
        return self:_add(Widgets.meter(self, id, opt or {}))
    end

    function proto:Custom(id, builder, opt)
        opt = opt or {}
        opt.build = builder
        return self:_add(Widgets.custom(self, id, opt))
    end

    function proto:AddCustom(builder, ...)
        assert(type(builder) == "function", "AddCustom expects function")
        local ctx = {
            ui = self.ui,
            win = self.win or self,
            target = self,
            body = self.body,
            theme = self.ui.theme,
            tk = UI.Toolkit,
            mk = mk,
            corner = corner,
            pad = pad,
            stroke = stroke,
            tween = tween,
        }
        local out = builder(self, ctx, ...)
        if out then
            return self:_add(out)
        end
    end

    function proto:AddLabel(text)
        local id, opt = parseOldArgs("label", text)
        return self:_add(Widgets.label(self, id, opt))
    end

    function proto:AddSeparator(text)
        local id, opt = parseOldArgs("section", text)
        return self:_add(Widgets.section(self, id, opt))
    end

    function proto:AddButton(text, cb)
        local id, opt = parseOldArgs("button", text, cb)
        return self:_add(Widgets.button(self, id, opt))
    end

    function proto:AddToggle(text, default, cb)
        local id, opt = parseOldArgs("toggle", text, default, cb)
        return self:_add(Widgets.toggle(self, id, opt))
    end

    function proto:AddSlider(text, min0, max0, default, step, cb)
        local id, opt = parseOldArgs("slider", text, min0, max0, default, step)
        opt.onChange = cb
        return self:_add(Widgets.slider(self, id, opt))
    end

    function proto:AddDropdown(text, items, default, cb)
        local id, opt = parseOldArgs("dropdown", text, items, default, cb)
        return self:_add(Widgets.dropdown(self, id, opt))
    end

    function proto:AddModeToggle(text, items, default, cb)
        local id, opt = parseOldArgs("mode", text, items, default, cb)
        return self:_add(Widgets.mode(self, id, opt))
    end

    function proto:AddKeybind(text, default, cb)
        local id, opt = parseOldArgs("keybind", text, default, cb)
        return self:_add(Widgets.keybind(self, id, opt))
    end

