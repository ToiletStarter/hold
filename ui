            w.ui.store:set(w.path, tostring(opt.default), { init = true, silent = true })
        end
        w:sub(w.ui.store:bind(w.path, function(v, _, _, meta)
            if meta and meta.src == w then return end
            w:_apply(v)
        end, false))
        w.value = w.ui.store:get(w.path, opt.default or "")
    else
        w.value = opt.default or opt.value or ""
    end
    w:render(w.value)
    return w
end

