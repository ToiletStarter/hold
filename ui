local function themeOf(name, override, accent)
    local base = Themes[name] or Themes.pastel
    local out = {}
    for k, v in pairs(base) do
        out[k] = v
    end
    if type(override) == "table" then
        for k, v in pairs(override) do
            out[k] = v
        end
    end
    if accent then
        out.accent = col(accent, out.accent)
        out.accentSoft = dim(out.accent, 0.45)
    elseif isColor(out.accent) and (not out.accentSoft or type(override) == "table" and override.accent and not override.accentSoft) then
        out.accentSoft = dim(out.accent, 0.45)
    end
    return out
end

local Store = {}
Store.__index = Store

function Store.new()
    return setmetatable({
        vals = {},
        roots = {},
        watch = {},
    }, Store)
end

function Store:mount(name, root)
    self.roots[name] = root
    return root
end

function Store:unmount(name)
    self.roots[name] = nil
end

function Store:_resolve(path)
    local head, tail = tostring(path or ""):match("^([^.]+)%.(.+)$")
    if head and self.roots[head] then
        return self.roots[head], tail, head
    end
    return self.vals, tostring(path or ""), nil
end

function Store:get(path, fallback)
    local root, tail = self:_resolve(path)
    local v = pathGet(root, tail)
    if v == nil then
        return fallback
    end
    return v
end

function Store:set(path, value, meta)
    local root, tail = self:_resolve(path)
    local old = pathGet(root, tail)
    pathSet(root, tail, value)
    local list = self.watch[path]
    if list then
        for i = 1, #list do
            safe(list[i], value, old, path, meta)
        end
    end
    return value
end

function Store:bind(path, fn, fire)
    local list = self.watch[path]
    if not list then
        list = {}
        self.watch[path] = list
    end
    list[#list + 1] = fn
    if fire then
        safe(fn, self:get(path), nil, path, { fire = true })
    end
    return function()
        local x = self.watch[path]
        if not x then
            return false
        end
        for i = #x, 1, -1 do
            if x[i] == fn then
                remove(x, i)
                return true
            end
        end
        return false
    end
end

local Router = {}
Router.__index = Router

function Router.new(ui)
    local self = setmetatable({
        ui = ui,
        cap = nil,
        hold = nil,
        cons = {},
    }, Router)

    self.cons[#self.cons + 1] = Input.InputBegan:Connect(function(input, gp)
        if ui._keyWidget and input.UserInputType == Enum.UserInputType.Keyboard then
            local w = ui._keyWidget
            ui._keyWidget = nil
            if input.KeyCode == Enum.KeyCode.Escape then
                w:set(nil)
            else
                w:set(input.KeyCode)
            end
            return
        end

        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == ui.menuKey and not gp then
            ui:Toggle()
            return
        end

        if ui._popup and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            local pos = input.Position
            local p = ui._popup
            local owner = ui._popupOwner
            local function inside(gui)
                if typeof(gui) ~= "Instance" or not gui.Parent or not gui:IsA("GuiObject") then
                    return false
                end
                local a = gui.AbsolutePosition
                local s = gui.AbsoluteSize
                return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
            end
            if not inside(p) and not inside(owner) then
                ui:_closePopup()
            end
        end

        if self.cap and self.cap.began then
            safe(self.cap.began, input, gp)
        end
    end)

    self.cons[#self.cons + 1] = Input.InputChanged:Connect(function(input, gp)
        if self.cap and self.cap.changed then
            safe(self.cap.changed, input, gp)
        end
    end)

    self.cons[#self.cons + 1] = Input.InputEnded:Connect(function(input, gp)
        if self.cap and self.cap.ended then
            safe(self.cap.ended, input, gp)
        end
    end)

    return self
end

function Router:capture(owner, bag)
    if self.cap and self.cap.owner == owner then
        self.cap = bag
        self.cap.owner = owner
        return
    end
    self.cap = bag or {}
    self.cap.owner = owner
end

function Router:release(owner)
    if self.cap and self.cap.owner == owner then
        self.cap = nil
    end
end

function Router:destroy()
    for i = #self.cons, 1, -1 do
        local c = self.cons[i]
        self.cons[i] = nil
        if c then
            pcall(function()
                c:Disconnect()
            end)
        end
    end
    self.cap = nil
end

local Widget = {}
Widget.__index = Widget

function Widget.new(win, id, kind, opt)
    local self = setmetatable({
        win = win,
        ui = win.ui,
        id = id,
        kind = kind,
        path = opt and opt.path,
        opt = opt or {},
        value = nil,
        row = nil,
        cons = {},
        unsubs = {},
        popup = nil,
        onChange = opt and opt.onChange,
        onPress = opt and opt.onPress,
    }, Widget)
    return self
end

function Widget:own(c)
    self.cons[#self.cons + 1] = c
    return c
end

function Widget:sub(fn)
    self.unsubs[#self.unsubs + 1] = fn
    return fn
end

function Widget:get()
    return self.value
end

function Widget:render(_) end

function Widget:validate(v)
    return v
end

function Widget:_apply(v)
    self.value = self:validate(v)
    self:render(self.value)
end

function Widget:set(v, silent)
    v = self:validate(v)
    local changed = v ~= self.value
    self.value = v
    self:render(v)
    if self.path then
        self.ui.store:set(self.path, v, { src = self, silent = silent })
    end
    if changed and not silent then
        safe(self.onChange, v, self)
    end
    return v
end

function Widget:sync()
    if self.path then
        self:_apply(self.ui.store:get(self.path, self.opt.default))
    else
        self:render(self.value)
    end
end

function Widget:applyTheme()
    self:render(self.value)
end

function Widget:destroy()
    if self.ui and self.ui._popupOwner == self.row then
        self.ui:_closePopup()
    end
    for i = #self.unsubs, 1, -1 do
        local fn = self.unsubs[i]
        self.unsubs[i] = nil
        safe(fn)
    end
    for i = #self.cons, 1, -1 do
        local c = self.cons[i]
        self.cons[i] = nil
        if typeof(c) == "RBXScriptConnection" then
            pcall(function()
                c:Disconnect()
            end)
        elseif type(c) == "function" then
            safe(c)
        end
    end
    if self.popup then
        pcall(function()
            self.popup:Destroy()
        end)
        self.popup = nil
    end
    if self.row then
        pcall(function()
            self.row:Destroy()
        end)
        self.row = nil
    end
end

