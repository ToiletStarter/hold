local function safe(fn, ...)
    if type(fn) ~= "function" then
        return true
    end
    return pcall(fn, ...)
end

local function isColor(v)
    return typeof(v) == "Color3"
end

local function col(v, fallback)
    if isColor(v) then
        return v
    end
    return fallback or Color3.new(1, 1, 1)
end

local function dim(c, a)
    c = col(c)
    a = a or 0.7
    return Color3.new(c.R * a, c.G * a, c.B * a)
end

local function cleanName(s)
    s = tostring(s or "default")
    s = s:gsub("[^%w_%-]", "_")
    if s == "" then
        s = "default"
    end
    return s
end

local function pathGet(t, path)
    local node = t
    for part in tostring(path or ""):gmatch("[^%.]+") do
        if type(node) ~= "table" then
            return nil
        end
        node = node[part]
    end
    return node
end

local function pathSet(t, path, value)
    local node = t
    local parts = {}
    for part in tostring(path or ""):gmatch("[^%.]+") do
        parts[#parts + 1] = part
    end
    if #parts == 0 then
        return value
    end
    for i = 1, #parts - 1 do
        local k = parts[i]
        if type(node[k]) ~= "table" then
            node[k] = {}
        end
        node = node[k]
    end
    node[parts[#parts]] = value
    return value
end

local function pack(v)
    local tv = typeof(v)
    if tv == "Color3" then
        return { __easyui = "Color3", r = v.R, g = v.G, b = v.B }
    elseif tv == "EnumItem" then
        return { __easyui = "EnumItem", enum = tostring(v.EnumType), name = v.Name }
    elseif type(v) == "table" then
        local out = {}
        for k, x in pairs(v) do
            out[k] = pack(x)
        end
        return out
    end
    return v
end

local function unpackValue(v)
    if type(v) == "table" and v.__easyui == "Color3" then
        return Color3.new(tonumber(v.r) or 1, tonumber(v.g) or 1, tonumber(v.b) or 1)
    elseif type(v) == "table" and v.__easyui == "EnumItem" then
        local rawEnum = tostring(v.enum or "")
        local enumName = rawEnum:match("Enum%.(.+)") or rawEnum
        local et = enumName and Enum[enumName]
        return et and et[v.name]
    elseif type(v) == "table" then
        local out = {}
        for k, x in pairs(v) do
            out[k] = unpackValue(x)
        end
        return out
    end
    return v
end

local function mk(className, props, parent)
    local inst = Instance.new(className)
    for k, v in pairs(props or {}) do
        pcall(function()
            inst[k] = v
        end)
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

local function corner(r, parent)
    return mk("UICorner", { CornerRadius = UDim.new(0, r or 0) }, parent)
end

local function pad(t, b, l, r, parent)
    return mk("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
        PaddingRight = UDim.new(0, r or 0),
    }, parent)
end

local function stroke(c, w, a, parent)
    return mk("UIStroke", {
        Color = c,
        Thickness = w or 1,
        Transparency = a or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function tween(obj, dur, props, style, dir)
    local info = TweenInfo.new(dur or 0.14, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
    local tw = Tween:Create(obj, info, props)
    tw:Play()
    return tw
end

local function bindFreeDrag(ui, key, gui, getRect, setPos)
    local dragging = false
    local offX, offY
    local dragTw
    gui.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton3 then
            return
        end
        local x, y = getRect()
        offX = input.Position.X - x
        offY = input.Position.Y - y
        dragging = true
        ui.router:capture(key, {
            changed = function(i)
                if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                    local nx = i.Position.X - offX
                    local ny = i.Position.Y - offY
                    if dragTw then pcall(function() dragTw:Cancel() end) end
                    dragTw = setPos(nx, ny)
                end
            end,
            ended = function(i)
                if dragging and i.UserInputType == Enum.UserInputType.MouseButton3 then
                    dragging = false
                    if dragTw then pcall(function() dragTw:Cancel() end) end
                    ui.router:release(key)
                end
            end,
        })
    end)
end

