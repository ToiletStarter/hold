    local shell = makeField(row, t, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0.5, 0), Vector2.new(0, 0.5), row.ZIndex + 1)
    local b = buttonText(shell, opt.text or opt.label or id or "Button", t, 11, shell.ZIndex + 1)
    local w = Widget.new(win, id or cleanName(opt.text or "button"), "button", opt)
    w.row = row
    w:own(b.MouseEnter:Connect(function()
        tween(shell, 0.1, { BackgroundColor3 = w.ui.theme.bg3 })
        tween(shell.UIStroke, 0.1, { Color = w.ui.theme.lineHi })
        tween(b, 0.1, { TextColor3 = w.ui.theme.accent })
    end))
    w:own(b.MouseLeave:Connect(function()
        tween(shell, 0.1, { BackgroundColor3 = w.ui.theme.bg2 })
        tween(shell.UIStroke, 0.1, { Color = w.ui.theme.line })
        tween(b, 0.1, { TextColor3 = w.ui.theme.text })
    end))
    w:own(b.MouseButton1Click:Connect(function()
        safe(opt.onPress or opt.onClick or w.onPress or w.onChange, w)
    end))
    function w:render(v)
        b.Text = tostring(v or opt.text or opt.label or id or "Button")
        shell.BackgroundColor3 = w.ui.theme.bg2
        if shell:FindFirstChildOfClass("UIStroke") then
            shell.UIStroke.Color = w.ui.theme.line
        end
        b.TextColor3 = w.ui.theme.text
    end
    function w:fire()
        safe(opt.onPress or opt.onClick or w.onPress or w.onChange, w)
    end
    w.value = opt.text or opt.label or id
    w:render(w.value)
    return w
end

