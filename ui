    label(row, opt.label or id or "Slider", t, 12, UDim2.new(0, 0, 0, 0), UDim2.new(0.65, 0, 0, 14), row.ZIndex + 1, Enum.TextXAlignment.Left, t.text)
    local valueLbl = label(row, "", t, 11, UDim2.new(0.65, 0, 0, 0), UDim2.new(0.35, 0, 0, 14), row.ZIndex + 1, Enum.TextXAlignment.Right, t.sub)
    local track = makeField(row, t, UDim2.new(1, 0, 0, 6), UDim2.new(0, 0, 1, -4), Vector2.new(0, 1), row.ZIndex + 1)
    corner(3, track)
    local fill = mk("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = t.accent,
        BorderSizePixel = 0,
        ZIndex = track.ZIndex + 1,
    }, track)
    corner(3, fill)
    local knob = mk("Frame", {
        Size = UDim2.new(0, 10, 0, 10),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = t.accent,
        BorderSizePixel = 0,
        ZIndex = track.ZIndex + 2,
    }, track)
    corner(5, knob)
    local hit = mk("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Size = UDim2.new(1, 14, 0, 18),
        Position = UDim2.new(0, -7, 1, -10),
        ZIndex = track.ZIndex + 3,
    }, row)
    local w = Widget.new(win, id or cleanName(opt.label), "slider", opt)
    w.row = row
    w.min = tonumber(opt.min) or 0
    w.max = tonumber(opt.max) or 100
    if w.max < w.min then
        w.min, w.max = w.max, w.min
    end
    w.step = tonumber(opt.step)
    if not w.step or w.step <= 0 then
        w.step = 1
    end
    local span = max(0.0001, w.max - w.min)
    local function snap(v)
        v = clamp(tonumber(v) or w.min, w.min, w.max)
        local s = w.step
        return floor((v - w.min) / s + 0.5) * s + w.min
    end
    local function show(v)
        if type(opt.format) == "function" then
            return tostring(opt.format(v))
        end
        if opt.decimals then
            return string.format("%." .. tostring(opt.decimals) .. "f", v)
        end
        if w.step % 1 == 0 then
            return tostring(floor(v + 0.5))
        end
        return tostring(v)
    end
    function w:validate(v)
        return snap(v)
    end
    function w:render(v)
        v = snap(v)
        local a = clamp((v - w.min) / span, 0, 1)
        fill.Size = UDim2.new(a, 0, 1, 0)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        fill.BackgroundColor3 = w.ui.theme.accent
        knob.BackgroundColor3 = w.ui.theme.accent
        track.BackgroundColor3 = w.ui.theme.bg2
        track.UIStroke.Color = w.ui.theme.line
        valueLbl.Text = show(v)
        valueLbl.TextColor3 = w.ui.theme.sub
    end
    local dragging = false
    local function pull(px)
        local width = max(track.AbsoluteSize.X, 1)
        local a = clamp((px - track.AbsolutePosition.X) / width, 0, 1)
        w:set(w.min + span * a)
    end
    local function release()
        dragging = false
        w.ui.router:release(w)
        tween(knob, 0.1, { Size = UDim2.new(0, 10, 0, 10) })
    end
    w:own(hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            pull(input.Position.X)
            tween(knob, 0.1, { Size = UDim2.new(0, 12, 0, 12) })
            w.ui.router:capture(w, {
                changed = function(i)
                    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                        pull(i.Position.X)
                    end
                end,
                ended = function(i)
                    if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
                        release()
                    end
                end,
            })
        end
    end))
    if w.path then
        if w.ui.store:get(w.path) == nil and opt.default ~= nil then
            w.ui.store:set(w.path, snap(opt.default), { init = true, silent = true })
        end
        w:sub(w.ui.store:bind(w.path, function(v, _, _, meta)
            if meta and meta.src == w then return end
            w:_apply(v)
        end, false))
        w.value = w.ui.store:get(w.path, opt.default or w.min)
    else
        w.value = opt.default or w.min
    end
    w:render(w.value)
    return w
end

