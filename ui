    local txt = label(shell, "", theme, 10, UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 1, 0), z + 1, Enum.TextXAlignment.Center, theme.sub)
    return function(w)
        local key = w.bindKey
        local active = w.ui._bindWidget == w
        shell.Visible = key ~= nil or active
        shell.BackgroundColor3 = w.ui.theme.bg2
        if shell:FindFirstChildOfClass("UIStroke") then
            shell.UIStroke.Color = active and w.ui.theme.accent or w.ui.theme.line
        end
        txt.Text = active and "..." or (key and tostring(key.Name):upper() or "")
        txt.TextColor3 = active and w.ui.theme.accent or w.ui.theme.sub
    end
end

local function hex(c)
    c = col(c)
    return fmt("#%02X%02X%02X", floor(c.R * 255 + 0.5), floor(c.G * 255 + 0.5), floor(c.B * 255 + 0.5))
end

local function parseHex(s)
    s = tostring(s or ""):gsub("#", ""):gsub("%s+", "")
    if #s ~= 6 then
        return nil
    end
    local r = tonumber(s:sub(1, 2), 16)
    local g = tonumber(s:sub(3, 4), 16)
    local b = tonumber(s:sub(5, 6), 16)
    if r and g and b then
        return Color3.fromRGB(r, g, b)
    end
end

