end

function UI:_front(win)
    self._top = self._top + 40
    local frame = win.frame
    local old = frame.ZIndex
    local new = self._top
    local delta = new - old
    frame.ZIndex = new
    for _, d in ipairs(frame:GetDescendants()) do
        if d:IsA("GuiObject") then
            d.ZIndex = d.ZIndex + delta
        end
    end
end

function UI:_nextPos(w)
    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1200, 800)
    if self._nextX + w + 16 > vp.X then
        self._nextX = 16
        self._nextY = self._nextY + 360
    end
    if self._nextY > vp.Y - 80 then
        self._nextY = 54
    end
    local x, y = self._nextX, self._nextY
    self._nextX = self._nextX + w + 12
    return x, y
end

