end

function UI:CreatePanel(title, opt)
    if type(opt) ~= "table" then
        opt = { Width = opt }
    end
    return self:Window(cleanName(title), title, opt)
end

function UI:Build(spec)
    local out = {}
    for _, w in ipairs(spec or {}) do
        local win = self:Window(w.id or cleanName(w.title), w.title or w.id, w)
        for _, item in ipairs(w.items or {}) do
            local kind = tostring(item.kind or "label"):lower()
            if kind == "section" or kind == "separator" then
                win:Section(item.text or item.label or "")
            elseif kind == "label" then
                win:Label(item.id or cleanName(item.text), item.text)
            elseif kind == "button" then
                win:Button(item.id or cleanName(item.text or item.label), item.text or item.label, item)
            elseif kind == "toggle" then
                win:Toggle(item.id or cleanName(item.label), item)
            elseif kind == "slider" then
                win:Slider(item.id or cleanName(item.label), item)
            elseif kind == "dropdown" then
                win:Dropdown(item.id or cleanName(item.label), item)
            elseif kind == "mode" then
                win:Mode(item.id or cleanName(item.label), item)
            elseif kind == "keybind" then
                win:Keybind(item.id or cleanName(item.label), item)
            elseif kind == "box" or kind == "textbox" then
                win:Box(item.id or cleanName(item.label), item)
            elseif kind == "color" or kind == "colorpicker" then
                win:Color(item.id or cleanName(item.label), item)
            elseif kind == "meter" or kind == "progress" then
                win:Meter(item.id or cleanName(item.label), item)
            else
                local builder = Widgets[kind]
                if builder then
                    win:_add(builder(win, item.id or kind, item))
                elseif Plugins[kind] then
                    safe(Plugins[kind], self, win, item)
                end
            end
        end
        out[#out + 1] = win
    end
    return out
end

function UI:Overlay(id, opt)
    opt = opt or {}
    if self.overlays[id] then
        self.overlays[id]:Destroy()
    end
    local frame = mk("Frame", {
        Name = id,
        Size = opt.Size or UDim2.fromOffset(opt.w or 120, opt.h or 30),
        Position = opt.Position or UDim2.fromOffset(opt.x or 20, opt.y or 20),
        AnchorPoint = opt.AnchorPoint or Vector2.new(0, 0),
        BackgroundColor3 = opt.BackgroundColor3 or self.theme.bg1,
        BackgroundTransparency = opt.BackgroundTransparency or 0,
        BorderSizePixel = 0,
        Visible = opt.Visible ~= false,
        ZIndex = 3300,
    }, self.hudRoot)
    if opt.Corner ~= false then
        corner(opt.Radius or 6, frame)
    end
    if opt.Stroke ~= false then
        stroke(opt.StrokeColor or self.theme.line, 1, 0, frame)
    end
    if opt.Padding ~= false then
        pad(opt.PadT or 6, opt.PadB or 6, opt.PadL or 6, opt.PadR or 6, frame)
    end
    local ov = { id = id, frame = frame, ui = self }
    function ov:Show(v) self.frame.Visible = v and true or false end
    function ov:GetFrame() return self.frame end
    function ov:Destroy()
        self.ui.overlays[self.id] = nil
        pcall(function() self.frame:Destroy() end)
    end
    self.overlays[id] = ov
    return ov
end

function UI:AddOverlay(id, builder, opt)
    local ov = self:Overlay(id, opt)
    safe(builder, ov, self, UI.Toolkit)
    return ov
end

