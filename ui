function UI:Toast(title, text, dur, kind)
    dur = dur or 2.4
    local c = kind == "ok" and self.theme.good or kind == "warn" and self.theme.warn or kind == "bad" and self.theme.bad or kind == "err" and self.theme.bad or self.theme.accent
    local item = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = self.theme.bg1,
        BorderSizePixel = 0,
        BackgroundTransparency = 0.05,
        LayoutOrder = os.clock() * 1000,
        ZIndex = 3600,
        ClipsDescendants = true,
    }, self.toastRoot)
    corner(6, item)
    stroke(self.theme.line, 1, 0, item)
    local bar = mk("Frame", {
        Size = UDim2.new(0, 2, 1, -10),
        Position = UDim2.new(0, 4, 0, 5),
        BackgroundColor3 = c,
        BorderSizePixel = 0,
        ZIndex = item.ZIndex + 1,
    }, item)
    corner(1, bar)
    local titleLbl = label(item, title or self.title, self.theme, 11, UDim2.new(0, 11, 0, 6), UDim2.new(1, -16, 0, 14), item.ZIndex + 1, Enum.TextXAlignment.Left, c)
    local body = mk("TextLabel", {
        Text = text or "",
        Font = Enum.Font.Gotham,
        TextSize = 10,
        TextColor3 = self.theme.sub,
        BackgroundTransparency = 1,
        TextWrapped = true,
        Size = UDim2.new(1, -16, 0, 24),
        Position = UDim2.new(0, 11, 0, 20),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = item.ZIndex + 1,
    }, item)
    local prog = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = c,
        BorderSizePixel = 0,
        ZIndex = item.ZIndex + 2,
    }, item)
    tween(prog, dur, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
    task.delay(dur, function()
        if not item.Parent then return end
        tween(item, 0.15, { BackgroundTransparency = 1 })
        tween(bar, 0.15, { BackgroundTransparency = 1 })
        tween(titleLbl, 0.15, { TextTransparency = 1 })
        tween(body, 0.15, { TextTransparency = 1 })
        task.delay(0.18, function()
            pcall(function() item:Destroy() end)
        end)
    end)
    item.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            pcall(function() item:Destroy() end)
        end
    end)
    return item
end

