        local n = 2
        while self.ui.widgetById[key] do
            key = base .. tostring(n)
            n = n + 1
        end
        widget.id = key
    end
    self.widgets[#self.widgets + 1] = widget
    self.ui.widgets[#self.ui.widgets + 1] = widget
    self.ui.widgetById[widget.id] = widget
    return widget
end

