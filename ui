end

local function makeField(parent, theme, size, pos, anchor, z)
    local f = mk("Frame", {
        Size = size,
        Position = pos,
        AnchorPoint = anchor or Vector2.new(0, 0.5),
        BackgroundColor3 = theme.bg2,
        BorderSizePixel = 0,
        ZIndex = z,
    }, parent)
    corner(5, f)
    stroke(theme.line, 1, 0, f)
    return f
end

