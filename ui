        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = shell.ZIndex + 2,
    }, shell)
    local w = Widget.new(win, id or cleanName(opt.label), "toggle", opt)
    w.row = row
    function w:validate(v)
        return v and true or false
    end
    function w:render(v)
        local on = v and true or false
        shell.BackgroundColor3 = on and w.ui.theme.accentSoft or w.ui.theme.bg2
        shell.UIStroke.Color = on and w.ui.theme.accent or w.ui.theme.line
        knob.BackgroundColor3 = on and w.ui.theme.accent or w.ui.theme.sub
        knob.Position = on and UDim2.new(1, -14, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
    end
    w:own(hit.MouseButton1Click:Connect(function()
        w:set(not w.value)
    end))
    if w.path then
        if w.ui.store:get(w.path) == nil and opt.default ~= nil then
            w.ui.store:set(w.path, opt.default, { init = true, silent = true })
        end
        w:sub(w.ui.store:bind(w.path, function(v, _, _, meta)
            if meta and meta.src == w then
                return
            end
            w:_apply(v)
        end, false))
        w.value = w.ui.store:get(w.path, opt.default)
    else
        w.value = opt.default
    end
    w:render(w.value)
    return w
end

