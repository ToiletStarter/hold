        ScrollBarImageColor3 = self.theme.lineHi,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ClipsDescendants = true,
        ZIndex = frame.ZIndex + 1,
    }, frame)
    pad(6, 6, 6, 6, body)
    local list = mk("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 4),
    }, body)

    selfWin.frame = frame
    selfWin.header = header
    selfWin.title = titleLbl
    selfWin.dot = dot
    selfWin.collapse = collapse
    selfWin.body = body
    selfWin.list = list

    list:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        selfWin:_refresh()
    end)
    collapse.MouseButton1Click:Connect(function()
        selfWin:ToggleOpen()
    end)
    collapse.MouseEnter:Connect(function()
        tween(collapse, 0.08, { TextColor3 = self.theme.accent })
    end)
    collapse.MouseLeave:Connect(function()
        tween(collapse, 0.08, { TextColor3 = selfWin.open and self.theme.accent or self.theme.dim })
    end)
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self:_front(selfWin)
        end
    end)

    selfWin:_bindDrag()
    selfWin:_refresh()

    self.windows[#self.windows + 1] = selfWin
    self.windowById[id] = selfWin
    return selfWin
end

function UI:CreateWindow(id, title, opt)
