local function makeBindChip(parent, theme, z, y, width)
    local shell = mk("Frame", {
        Size = UDim2.new(0, width or 42, 0, 16),
        Position = UDim2.new(1, 0, 0, y or 0),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = theme.bg2,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = z,
    }, parent)
    corner(4, shell)
