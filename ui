    bindFreeDrag(self, frame, frame, function()
        return frame.Position.X.Offset, frame.Position.Y.Offset
    end, function(x, y)
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1200, 800)
        x = clamp(x, 4, max(4, vp.X - frame.AbsoluteSize.X - 4))
        y = clamp(y, 4, max(4, vp.Y - frame.AbsoluteSize.Y - 4))
        return tween(frame, 0.08, { Position = UDim2.fromOffset(x, y) })
    end)
    self._wm = frame
    self._wmBar = bar
    self._wmLabel = lbl
    self:_refreshWatermark()
end

