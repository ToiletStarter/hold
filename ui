                return v
            end
        end
        return tostring(w.items[1] or "")
    end
    function w:render(v)
        txt.Text = tostring(v or "")
        txt.TextColor3 = w.ui.theme.text
        shell.BackgroundColor3 = w.ui.theme.bg3
        shell.UIStroke.Color = w.ui.theme.line
        arrow.TextColor3 = w.ui.theme.text
        syncBind(w)
    end
    function w:setItems(items)
        w.items = items or {}
        w:set(w.value, true)
    end
    local function open()
        local theme = w.ui.theme
        local frame = w.ui:_popup(shell, Vector2.new(140, max(26, #w.items * 22 + 8)))
        frame.BackgroundColor3 = theme.bg1
        stroke(theme.line, 1, 0, frame)
        corner(6, frame)
        pad(4, 4, 4, 4, frame)
        local list = mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, frame)
        for _, item in ipairs(w.items) do
            local cell = mk("TextButton", {
                Text = tostring(item),
                Font = Enum.Font.Gotham,
                TextSize = 11,
                TextColor3 = tostring(item) == tostring(w.value) and theme.accent or theme.sub,
                BackgroundColor3 = theme.bg2,
                BackgroundTransparency = 1,
                AutoButtonColor = false,
                Size = UDim2.new(1, 0, 0, 20),
                ZIndex = frame.ZIndex + 1,
            }, frame)
            corner(4, cell)
            cell.MouseEnter:Connect(function()
                tween(cell, 0.08, { BackgroundTransparency = 0, BackgroundColor3 = theme.bg3 })
            end)
            cell.MouseLeave:Connect(function()
                tween(cell, 0.08, { BackgroundTransparency = 1 })
            end)
            cell.MouseButton1Click:Connect(function()
                w:set(item)
                w.ui:_closePopup()
            end)
        end
        w.popup = frame
    end
    w:own(hit.MouseButton1Click:Connect(function()
        if w.ui._popup == w.popup and w.popup then
            w.ui:_closePopup()
        else
            open()
        end
    end))
    function w:activate()
        if #w.items == 0 then return end
        local idx = 1
        for i, x in ipairs(w.items) do
            if tostring(x) == tostring(w.value) then idx = i break end
        end
        idx = idx + 1
        if idx > #w.items then idx = 1 end
        w:set(w.items[idx])
    end
    attachBind(w, row, shell)
    if w.path then
        if w.ui.store:get(w.path) == nil and opt.default ~= nil then
            w.ui.store:set(w.path, w:validate(opt.default), { init = true, silent = true })
        end
        w:sub(w.ui.store:bind(w.path, function(v, _, _, meta)
            if meta and meta.src == w then return end
            w:_apply(v)
        end, false))
        w.value = w.ui.store:get(w.path, opt.default or w.items[1])
    else
        w.value = opt.default or w.items[1]
    end
    w:render(w:validate(w.value))
    return w
end

