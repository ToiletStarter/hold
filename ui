    pad(6, 6, 6, 6, body)
    local list = mk("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 4),
    }, body)
    return body, list
end

local function ensureColumns(target, count)
    count = max(1, floor(tonumber(count) or 1 + 0.5))
    if target.columns == count and target.colWrap and target.colWrap.Parent == target.body then
        return
    end
    target.columns = count
    if target.colWrap then
        pcall(function() target.colWrap:Destroy() end)
    end
    target.colWrap = nil
    target.colFrames = nil
    target.colLists = nil
    if count <= 1 then
        return
    end
    local wrap = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = target.frame.ZIndex + 1,
    }, target.body)
    local frames, lists = {}, {}
    for i = 1, count do
        local width = 1 / count
        local f = mk("Frame", {
            Size = UDim2.new(width, i == 1 and -4 or -4, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Position = UDim2.new((i - 1) * width, i == 1 and 0 or 4, 0, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = target.frame.ZIndex + 1,
        }, wrap)
        local l = mk("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8),
        }, f)
        frames[i] = f
        lists[i] = l
    end
    target.colWrap = wrap
    target.colFrames = frames
    target.colLists = lists
end

