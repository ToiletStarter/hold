function UI:Build(spec)
    local out = {}
    for _, w in ipairs(spec or {}) do
        local win = self:Window(w.id or cleanName(w.title), w.title or w.id, w)
        for _, item in ipairs(w.items or {}) do
            local kind = tostring(item.kind or "label"):lower()
            if kind == "section" or kind == "separator" then
                win:Section(item.text or item.label or "")
            elseif kind == "label" then
                win:Label(item.id or cleanName(item.text), item.text)
            elseif kind == "button" then
                win:Button(item.id or cleanName(item.text or item.label), item.text or item.label, item)
            elseif kind == "toggle" then
                win:Toggle(item.id or cleanName(item.label), item)
            elseif kind == "slider" then
                win:Slider(item.id or cleanName(item.label), item)
            elseif kind == "dropdown" then
                win:Dropdown(item.id or cleanName(item.label), item)
            elseif kind == "mode" then
                win:Mode(item.id or cleanName(item.label), item)
            elseif kind == "keybind" then
                win:Keybind(item.id or cleanName(item.label), item)
            elseif kind == "box" or kind == "textbox" then
                win:Box(item.id or cleanName(item.label), item)
            elseif kind == "color" or kind == "colorpicker" then
                win:Color(item.id or cleanName(item.label), item)
            elseif kind == "meter" or kind == "progress" then
                win:Meter(item.id or cleanName(item.label), item)
            else
                local builder = Widgets[kind]
                if builder then
                    win:_add(builder(win, item.id or kind, item))
                elseif Plugins[kind] then
                    safe(Plugins[kind], self, win, item)
                end
            end
        end
        out[#out + 1] = win
    end
    self:_resolveAll()
    return out
end

function UI:BuildFromDescriptors(descs, opt)
    opt = opt or {}
    local grouped = {}
    for i = 1, #(descs or {}) do
        local d = descs[i]
        local winName = d.window or opt.window or "Main"
        local tabName = d.tab
        local subName = d.subtab
        grouped[winName] = grouped[winName] or { items = {}, tabs = {}, order = d.windowOrder or 0, width = d.windowWidth }
        local g = grouped[winName]
        g.order = g.order or d.windowOrder or 0
        g.width = g.width or d.windowWidth
        if tabName and tabName ~= "" then
            g.tabs[tabName] = g.tabs[tabName] or { subtabs = {}, items = {}, order = d.tabOrder or 0 }
            local tg = g.tabs[tabName]
            tg.order = tg.order or d.tabOrder or 0
            if subName and subName ~= "" then
                tg.subtabs[subName] = tg.subtabs[subName] or { items = {}, order = d.subtabOrder or 0 }
                local sg = tg.subtabs[subName]
                sg.order = sg.order or d.subtabOrder or 0
                sg.items[#sg.items + 1] = d
            else
                tg.items[#tg.items + 1] = d
            end
        else
            g.items[#g.items + 1] = d
        end
    end

    local wins = {}
    local function sortItems(items)
        table.sort(items, function(a, b)
            local sa, sb = tostring(a.section or ""), tostring(b.section or "")
            if sa ~= sb then return sa < sb end
            return (a.order or 0) < (b.order or 0)
        end)
    end

    local function addOne(target, d)
        local kind = tostring(d.kind or "label"):lower()
        local id = d.id or cleanName((d.path or d.label or kind):gsub("[%.]", "_"))
        if kind == "toggle" then
            target:Toggle(id, d)
        elseif kind == "slider" then
            target:Slider(id, d)
        elseif kind == "dropdown" then
            target:Dropdown(id, d)
        elseif kind == "mode" then
            target:Mode(id, d)
        elseif kind == "keybind" then
            target:Keybind(id, d)
        elseif kind == "box" or kind == "textbox" or kind == "number" then
            target:Box(id, d)
        elseif kind == "color" or kind == "colorpicker" then
            target:Color(id, d)
        elseif kind == "meter" or kind == "progress" then
            target:Meter(id, d)
        elseif kind == "button" then
            target:Button(id, d.text or d.label or id, d)
        elseif kind == "label" or kind == "note" then
            target:Label(id, d.text or d.label or "")
        elseif kind == "section" or kind == "separator" then
            target:Section(d.text or d.label or d.section or id)
        end
    end

    local function addItems(target, items)
        sortItems(items)
        if target.SetColumns then
            local cols = opt.columns or (#items >= 10 and 2 or 1)
            target:SetColumns(cols)
        end
        local buckets, order = {}, {}
        for i = 1, #items do
            local d = items[i]
            local section = d.section or "Main"
            local kind = tostring(d.kind or "label"):lower()
            if kind == "section" or kind == "separator" then
                section = d.text or d.label or section
            end
            if not buckets[section] then
                buckets[section] = {}
                order[#order + 1] = section
            end
            if kind ~= "section" and kind ~= "separator" then
                buckets[section][#buckets[section] + 1] = d
            end
        end
        for i = 1, #order do
            local section = order[i]
            local bucket = buckets[section]
            if #bucket == 0 then
                target:Section(section)
            else
                local group = target:Group(cleanName(section), section)
                for j = 1, #bucket do
                    addOne(group, bucket[j])
                end
            end
        end
    end

    local names = {}
    for name in pairs(grouped) do names[#names + 1] = name end
    table.sort(names, function(a, b)
        local ga, gb = grouped[a], grouped[b]
        local oa = (opt.windowOrder and opt.windowOrder[a]) or ga.order or 0
        local ob = (opt.windowOrder and opt.windowOrder[b]) or gb.order or 0
        if oa ~= ob then return oa < ob end
        return tostring(a) < tostring(b)
    end)

    for i = 1, #names do
        local name = names[i]
        local g = grouped[name]
        local hasTabs = next(g.tabs) ~= nil
        if hasTabs and #g.items > 0 then
            g.tabs[opt.defaultTab or "Main"] = g.tabs[opt.defaultTab or "Main"] or { subtabs = {}, items = {}, order = -math.huge }
            local targetTab = g.tabs[opt.defaultTab or "Main"]
            for ii = 1, #g.items do
                targetTab.items[#targetTab.items + 1] = g.items[ii]
            end
            g.items = {}
        end
        local width = (opt.windowWidth and opt.windowWidth[name]) or g.width or opt.Width or 280
        local win = self:Window(cleanName(name), name, { Width = width })
        addItems(win, g.items)
        local tabNames = {}
        for tn in pairs(g.tabs) do tabNames[#tabNames + 1] = tn end
        table.sort(tabNames, function(a, b)
            local ta, tb = g.tabs[a], g.tabs[b]
            local oa = ta.order or 0
            local ob = tb.order or 0
            if oa ~= ob then return oa < ob end
            return tostring(a) < tostring(b)
        end)
        for ti = 1, #tabNames do
            local tabName = tabNames[ti]
            local tg = g.tabs[tabName]
            local tab = win:Tab(cleanName(tabName), tabName)
            addItems(tab, tg.items)
            local subNames = {}
            for sn in pairs(tg.subtabs) do subNames[#subNames + 1] = sn end
            table.sort(subNames, function(a, b)
                local sa, sb = tg.subtabs[a], tg.subtabs[b]
                local oa = sa.order or 0
                local ob = sb.order or 0
                if oa ~= ob then return oa < ob end
                return tostring(a) < tostring(b)
            end)
            for si = 1, #subNames do
                local subName = subNames[si]
                local sg = tg.subtabs[subName]
                local sub = tab:SubTab(cleanName(subName), subName)
                addItems(sub, sg.items)
            end
        end
        wins[#wins + 1] = win
    end
    self:_resolveAll()
    return wins
end

function UI:Overlay(id, opt)
    opt = opt or {}
    if self.overlays[id] then
        self.overlays[id]:Destroy()
    end
    local frame = mk("Frame", {
        Name = id,
        Size = opt.Size or UDim2.fromOffset(opt.w or 120, opt.h or 30),
        Position = opt.Position or UDim2.fromOffset(opt.x or 20, opt.y or 20),
        AnchorPoint = opt.AnchorPoint or Vector2.new(0, 0),
        BackgroundColor3 = opt.BackgroundColor3 or self.theme.bg1,
        BackgroundTransparency = opt.BackgroundTransparency or 0,
        BorderSizePixel = 0,
        Visible = opt.Visible ~= false,
        ZIndex = 3300,
    }, self.hudRoot)
    if opt.Corner ~= false then
        corner(opt.Radius or 6, frame)
    end
    if opt.Stroke ~= false then
        stroke(opt.StrokeColor or self.theme.line, 1, 0, frame)
    end
    if opt.Padding ~= false then
        pad(opt.PadT or 6, opt.PadB or 6, opt.PadL or 6, opt.PadR or 6, frame)
    end
    bindFreeDrag(self, frame, frame, function()
        return frame.Position.X.Offset, frame.Position.Y.Offset
    end, function(x, y)
        local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1200, 800)
        x = clamp(x, 4, max(4, vp.X - frame.AbsoluteSize.X - 4))
        y = clamp(y, 4, max(4, vp.Y - frame.AbsoluteSize.Y - 4))
        return tween(frame, 0.08, { Position = UDim2.fromOffset(x, y) })
    end)
    local ov = { id = id, frame = frame, ui = self }
    function ov:Show(v) self.frame.Visible = v and true or false end
    function ov:GetFrame() return self.frame end
    function ov:Destroy()
        self.ui.overlays[self.id] = nil
        pcall(function() self.frame:Destroy() end)
    end
    self.overlays[id] = ov
    return ov
end

function UI:AddOverlay(id, builder, opt)
    local ov = self:Overlay(id, opt)
    safe(builder, ov, self, UI.Toolkit)
    return ov
end

