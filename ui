function Widget.new(win, id, kind, opt)
    local self = setmetatable({
        win = win,
        ui = win.ui,
        id = id,
        kind = kind,
        path = opt and opt.path,
        opt = opt or {},
        value = nil,
        row = nil,
        cons = {},
        unsubs = {},
        popup = nil,
        bindKey = opt and (opt.bindKey or opt.bind),
        onChange = opt and opt.onChange,
        onPress = opt and opt.onPress,
    }, Widget)
    return self
end

function Widget:own(c)
    self.cons[#self.cons + 1] = c
    return c
end

function Widget:sub(fn)
    self.unsubs[#self.unsubs + 1] = fn
    return fn
end

function Widget:get()
    return self.value
end

function Widget:setBind(key)
    self.bindKey = key
    if self.ui then
        local name = tostring(self.opt.label or self.id)
        if key then
            self.ui:Toast("Bind", name .. " -> " .. tostring(key.Name), 1.2, "ok")
        else
            self.ui:Toast("Bind", name .. " bind cleared", 1.2, "warn")
        end
    end
    return key
end

function Widget:getBind()
    return self.bindKey
end

function Widget:beginBind(target)
    if self.kind == "label" or self.kind == "section" or self.kind == "keybind" then
        return
    end
    self.ui._bindWidget = self
    if target and target:IsA("GuiObject") then
        if target:IsA("TextButton") or target:IsA("TextBox") then
            target.TextColor3 = self.ui.theme.accent
        elseif target:FindFirstChildOfClass("UIStroke") then
            target.UIStroke.Color = self.ui.theme.accent
        end
    end
    self.ui:Toast("Bind", "Press a key for " .. tostring(self.opt.label or self.id) .. " (Esc to clear)", 1.4, "warn")
end

function Widget:activate() end

function Widget:render(_) end

function Widget:validate(v)
    return v
end

function Widget:_apply(v)
    self.value = self:validate(v)
    self:render(self.value)
end

function Widget:set(v, silent)
    v = self:validate(v)
    local changed = v ~= self.value
    self.value = v
    self:render(v)
    if self.path then
        self.ui.store:set(self.path, v, { src = self, silent = silent })
    end
    if changed and not silent then
        safe(self.onChange, v, self)
    end
    return v
end

function Widget:sync()
    if self.path then
        self:_apply(self.ui.store:get(self.path, self.opt.default))
    else
        self:render(self.value)
    end
end

function Widget:applyTheme()
    self:render(self.value)
end

function Widget:destroy()
    if self.ui and self.ui._popupOwner == self.row then
        self.ui:_closePopup()
    end
    for i = #self.unsubs, 1, -1 do
        local fn = self.unsubs[i]
        self.unsubs[i] = nil
        safe(fn)
    end
    for i = #self.cons, 1, -1 do
        local c = self.cons[i]
        self.cons[i] = nil
        if typeof(c) == "RBXScriptConnection" then
            pcall(function()
                c:Disconnect()
            end)
        elseif type(c) == "function" then
            safe(c)
        end
    end
    if self.popup then
        pcall(function()
            self.popup:Destroy()
        end)
        self.popup = nil
    end
    if self.row then
        pcall(function()
            self.row:Destroy()
        end)
        self.row = nil
    end
end

