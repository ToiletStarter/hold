    end)
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            self:_front(selfWin)
        end
    end)

    selfWin:_bindDrag()
    selfWin:_refresh()

    self.windows[#self.windows + 1] = selfWin
    self.windowById[id] = selfWin
    self:_resolveWindow(selfWin)
    return selfWin
end

