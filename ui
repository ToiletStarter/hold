    local w = size.X
    local h = size.Y
    local x = clamp(pos.X + sz.X + 8, 8, max(8, vp.X - w - 8))
    local y = clamp(pos.Y, 8, max(8, vp.Y - h - 8))
    local frame = mk("Frame", {
        Size = UDim2.fromOffset(w, h),
        Position = UDim2.fromOffset(x, y),
        BorderSizePixel = 0,
        BackgroundColor3 = self.theme.bg1,
        ZIndex = 4000,
        ClipsDescendants = true,
    }, self.hudRoot)
    self._popup = frame
    self._popupOwner = owner
    return frame
end

function UI:_closePopup()
