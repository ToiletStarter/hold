--!nocheck
-- EasyUI UI — a clean, matte, black/white Roblox menu library.
-- Execute this file directly to see the demo (bottom of file).

local Players = game:GetService("Players")
local UserInput = game:GetService("UserInputService")
local Tween = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

local LP = Players.LocalPlayer
local Mouse = LP and LP:GetMouse()

--==================================================================
-- Theme
--==================================================================
local Theme = {
	Font = Enum.Font.GothamMedium,
	FontBold = Enum.Font.GothamBold,
	FontMono = Enum.Font.Code,

	Accent = Color3.fromRGB(236, 236, 240),
	AccentSoft = Color3.fromRGB(150, 150, 158),

	Window = Color3.fromRGB(15, 15, 17),
	Panel = Color3.fromRGB(21, 21, 24),
	Card = Color3.fromRGB(27, 27, 31),
	Control = Color3.fromRGB(33, 33, 38),
	Hover = Color3.fromRGB(42, 42, 48),

	Stroke = Color3.fromRGB(46, 46, 53),
	StrokeSoft = Color3.fromRGB(36, 36, 42),

	Text = Color3.fromRGB(240, 240, 245),
	Sub = Color3.fromRGB(150, 150, 160),
	Muted = Color3.fromRGB(96, 96, 106),

	Good = Color3.fromRGB(172, 226, 191),
	Warn = Color3.fromRGB(240, 214, 168),
	Bad = Color3.fromRGB(240, 172, 178),
}

--==================================================================
-- Easing presets (Apple-ish)
--==================================================================
local E = {
	Smooth = TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
	Fast = TweenInfo.new(0.12, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
	Snap = TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	Pop = TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
	Linear = TweenInfo.new(0.15, Enum.EasingStyle.Linear),
}

--==================================================================
-- Low-level helpers
--==================================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if k ~= "Parent" then
				inst[k] = v
			end
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function tw(inst, info, props)
	local t = Tween:Create(inst, info, props)
	t:Play()
	return t
end

local function corner(radius, parent)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 8), Parent = parent })
end

local function stroke(color, thickness, transparency, parent)
	return new("UIStroke", {
		Color = color or Theme.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function pad(all, parent, l, t, r, b)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, l or all),
		PaddingRight = UDim.new(0, r or all),
		PaddingTop = UDim.new(0, t or all),
		PaddingBottom = UDim.new(0, b or all),
		Parent = parent,
	})
end

local function list(parent, gap, dir)
	return new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap or 6),
		Parent = parent,
	})
end

local function label(text, size, color, font, parent)
	return new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text or "",
		TextSize = size or 13,
		TextColor3 = color or Theme.Text,
		Font = font or Theme.Font,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		RichText = true,
		Parent = parent,
	})
end

-- ripple feedback on a button surface
local function ripple(parent)
	local circle = new("Frame", {
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.86,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 20,
		Parent = parent,
	})
	corner(999, circle)
	local sz = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y) * 1.6
	tw(circle, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = UDim2.fromOffset(sz, sz),
		BackgroundTransparency = 1,
	})
	task.delay(0.46, function()
		circle:Destroy()
	end)
end

local function hoverable(inst, base, hover)
	inst.MouseEnter:Connect(function()
		tw(inst, E.Fast, { BackgroundColor3 = hover })
	end)
	inst.MouseLeave:Connect(function()
		tw(inst, E.Fast, { BackgroundColor3 = base })
	end)
end

local function mountGui()
	local root = new("ScreenGui", {
		Name = "EasyUI_" .. tostring(math.random(1e5, 9e5)),
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true,
	})
	local ok = pcall(function()
		if syn and syn.protect_gui then
			syn.protect_gui(root)
			root.Parent = CoreGui
		elseif gethui then
			root.Parent = gethui()
		else
			root.Parent = CoreGui
		end
	end)
	if not ok or not root.Parent then
		root.Parent = LP and LP:WaitForChild("PlayerGui") or CoreGui
	end
	return root
end

--==================================================================
-- Draggable
--==================================================================
local function draggable(handle, target)
	local dragging, startInput, startPos
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startInput = i.Position
			startPos = target.Position
			local conn
			conn = i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					dragging = false
					conn:Disconnect()
				end
			end)
		end
	end)
	UserInput.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startInput
			tw(target, TweenInfo.new(0.05, Enum.EasingStyle.Linear), {
				Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y),
			})
		end
	end)
end

--==================================================================
-- Library
--==================================================================
local EasyUI = {}
EasyUI.__index = EasyUI

function EasyUI.new(opts)
	opts = opts or {}
	local self = setmetatable({}, EasyUI)
	self.gui = mountGui()
	self.toggleKey = opts.toggleKey or Enum.KeyCode.RightShift
	self.title = opts.title or "EasyUI"
	self.tabs = {}
	self.visible = true
	if opts.accent then
		Theme.Accent = opts.accent
	end

	local width = opts.width or 560
	local height = opts.height or 420

	local win = new("Frame", {
		Name = "Window",
		Size = UDim2.fromOffset(width, height),
		Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2),
		BackgroundColor3 = Theme.Window,
		BorderSizePixel = 0,
		Parent = self.gui,
	})
	corner(12, win)
	stroke(Theme.Stroke, 1, 0.2, win)
	self.window = win

	-- soft drop shadow
	new("ImageLabel", {
		BackgroundTransparency = 1,
		Image = "rbxassetid://5554236805",
		ImageColor3 = Color3.new(0, 0, 0),
		ImageTransparency = 0.45,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(23, 23, 277, 277),
		Size = UDim2.new(1, 60, 1, 60),
		Position = UDim2.new(0, -30, 0, -30),
		ZIndex = 0,
		Parent = win,
	})

	local scale = new("UIScale", { Scale = 1, Parent = win })
	self._scale = scale

	-- title bar
	local bar = new("Frame", {
		Name = "TitleBar",
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundTransparency = 1,
		Parent = win,
	})
	draggable(bar, win)
	local dot = new("Frame", {
		Size = UDim2.fromOffset(9, 9),
		Position = UDim2.new(0, 16, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = bar,
	})
	corner(999, dot)
	local titleLbl = label(self.title, 14, Theme.Text, Theme.FontBold, bar)
	titleLbl.Position = UDim2.new(0, 34, 0, 0)
	titleLbl.Size = UDim2.new(1, -120, 1, 0)

	-- close / minimize pills
	local function pill(x, color, cb)
		local b = new("TextButton", {
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromOffset(24, 24),
			Position = UDim2.new(1, x, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			BackgroundColor3 = Theme.Control,
			BorderSizePixel = 0,
			Parent = bar,
		})
		corner(7, b)
		stroke(Theme.StrokeSoft, 1, 0, b)
		local ic = new("Frame", {
			Size = UDim2.fromOffset(9, 2),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = b,
		})
		corner(2, ic)
		hoverable(b, Theme.Control, Theme.Hover)
		b.MouseButton1Click:Connect(cb)
		return b, ic
	end
	pill(-14, Theme.Bad, function()
		self:Close()
	end)
	local _, minIc = pill(-44, Theme.Sub, function()
		self:Minimize()
	end)
	self._minIc = minIc

	new("Frame", {
		Size = UDim2.new(1, -32, 0, 1),
		Position = UDim2.new(0, 16, 0, 42),
		BackgroundColor3 = Theme.StrokeSoft,
		BorderSizePixel = 0,
		Parent = win,
	})

	-- sidebar
	local side = new("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, 150, 1, -54),
		Position = UDim2.new(0, 0, 0, 50),
		BackgroundTransparency = 1,
		Parent = win,
	})
	pad(12, side, 12, 6, 6, 12)
	list(side, 4)
	self._side = side

	-- content holder
	local content = new("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -150, 1, -54),
		Position = UDim2.new(0, 150, 0, 50),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = win,
	})
	self._content = content

	-- watermark pill (top-right corner of screen)
	local wm = new("Frame", {
		Size = UDim2.fromOffset(160, 26),
		Position = UDim2.new(0, 16, 0, 16),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Parent = self.gui,
	})
	corner(8, wm)
	stroke(Theme.Stroke, 1, 0.1, wm)
	draggable(wm, wm)
	local wmText = label(self.title .. "  •  0 fps", 12, Theme.Sub, Theme.FontMono, wm)
	wmText.Position = UDim2.new(0, 10, 0, 0)
	wmText.Size = UDim2.new(1, -20, 1, 0)
	self._wmText = wmText
	self.watermark = opts.watermark ~= false
	wm.Visible = self.watermark

	-- fps in watermark
	do
		local acc, frames = 0, 0
		RunService.RenderStepped:Connect(function(dt)
			acc += dt
			frames += 1
			if acc >= 0.5 then
				local fps = math.floor(frames / acc + 0.5)
				acc, frames = 0, 0
				if wmText and wmText.Parent then
					wmText.Text = self.title .. "  •  " .. fps .. " fps"
				end
			end
		end)
	end

	-- open animation
	scale.Scale = 0.9
	win.BackgroundTransparency = 1
	tw(win, E.Pop, { BackgroundTransparency = 0 })
	tw(scale, E.Pop, { Scale = 1 })

	-- toggle key
	UserInput.InputBegan:Connect(function(i, gp)
		if gp then
			return
		end
		if i.KeyCode == self.toggleKey then
			self:SetVisible(not self.visible)
		end
	end)

	self._toasts = {}
	return self
end

function EasyUI:SetVisible(v)
	self.visible = v
	if v then
		self.window.Visible = true
		self._scale.Scale = 0.92
		self.window.BackgroundTransparency = 1
		tw(self.window, E.Pop, { BackgroundTransparency = 0 })
		tw(self._scale, E.Pop, { Scale = 1 })
	else
		tw(self._scale, E.Smooth, { Scale = 0.92 })
		local t = tw(self.window, E.Smooth, { BackgroundTransparency = 1 })
		t.Completed:Connect(function()
			if not self.visible then
				self.window.Visible = false
			end
		end)
	end
end

function EasyUI:Minimize()
	self:SetVisible(false)
end

function EasyUI:Close()
	tw(self._scale, E.Smooth, { Scale = 0.85 })
	local t = tw(self.window, E.Smooth, { BackgroundTransparency = 1 })
	t.Completed:Connect(function()
		self.gui:Destroy()
	end)
end

--==================================================================
-- Tabs
--==================================================================
function EasyUI:Tab(name)
	local self_ = self
	local btn = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Theme.Control,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 2,
		LayoutOrder = #self.tabs + 1,
		Parent = self._side,
	})
	corner(8, btn)
	local btnStroke = stroke(Theme.StrokeSoft, 1, 1, btn)
	local tl = label(name, 13, Theme.Sub, Theme.Font, btn)
	tl.Position = UDim2.new(0, 12, 0, 0)
	tl.Size = UDim2.new(1, -12, 1, 0)
	tl.ZIndex = 3

	local page = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Stroke,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticCanvasSize.Y,
		Visible = false,
		Parent = self._content,
	})
	pad(14, page, 14, 12, 14, 16)
	list(page, 12)

	local tab = { name = name, button = btn, stroke = btnStroke, page = page, label = tl }
	self.tabs[#self.tabs + 1] = tab

	local function activate()
		for _, t in ipairs(self_.tabs) do
			t.page.Visible = false
			tw(t.button, E.Fast, { BackgroundTransparency = 1 })
			tw(t.stroke, E.Fast, { Transparency = 1 })
			tw(t.label, E.Fast, { TextColor3 = Theme.Sub })
		end
		page.Visible = true
		tw(btn, E.Fast, { BackgroundTransparency = 0 })
		tw(btnStroke, E.Fast, { Transparency = 0 })
		tw(tl, E.Fast, { TextColor3 = Theme.Text })
	end
	btn.MouseButton1Click:Connect(activate)
	btn.MouseEnter:Connect(function()
		if not page.Visible then
			tw(tl, E.Fast, { TextColor3 = Theme.Text })
		end
	end)
	btn.MouseLeave:Connect(function()
		if not page.Visible then
			tw(tl, E.Fast, { TextColor3 = Theme.Sub })
		end
	end)

	if #self.tabs == 1 then
		task.defer(activate)
	end

	return setmetatable({ _m = self, _page = page }, { __index = EasyUI._Tab })
end

EasyUI._Tab = {}

function EasyUI._Tab:Section(title)
	local card = new("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Parent = self._page,
	})
	corner(10, card)
	stroke(Theme.StrokeSoft, 1, 0, card)
	pad(12, card)
	local col = list(card, 8)
	local head = label(title, 13, Theme.Text, Theme.FontBold, card)
	head.Size = UDim2.new(1, 0, 0, 18)
	head.LayoutOrder = -1
	return setmetatable({ _m = self._m, _card = card }, { __index = EasyUI._Section })
end

