-- Widgets
--==================================================================
EasyUI._Section = {}

local function row(parent, h)
	return new("Frame", {
		Size = UDim2.new(1, 0, 0, h or 30),
		BackgroundTransparency = 1,
		Parent = parent,
	})
end

function EasyUI._Section:Label(text)
	local l = label(text, 12, Theme.Sub, Theme.Font, self._card)
	l.Size = UDim2.new(1, 0, 0, 16)
	l.TextWrapped = true
	l.AutomaticSize = Enum.AutomaticSize.Y
	return l
end

function EasyUI._Section:Toggle(o)
	o = o or {}
	local state = o.default or false
	local r = row(self._card, 28)
	local l = label(o.text or "Toggle", 13, Theme.Text, Theme.Font, r)
	l.Size = UDim2.new(1, -50, 1, 0)

	local track = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(40, 22),
		Position = UDim2.new(1, 0, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = state and Theme.Accent or Theme.Control,
		BorderSizePixel = 0,
		Parent = r,
	})
	corner(999, track)
	stroke(Theme.StrokeSoft, 1, 0, track)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(16, 16),
		Position = state and UDim2.new(1, -3, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		AnchorPoint = Vector2.new(state and 1 or 0, 0.5),
		BackgroundColor3 = state and Theme.Window or Theme.Sub,
		BorderSizePixel = 0,
		Parent = track,
	})
	corner(999, knob)

	local api = {}
	function api:Set(v)
		state = v and true or false
		tw(track, E.Smooth, { BackgroundColor3 = state and Theme.Accent or Theme.Control })
		tw(knob, E.Snap, {
			Position = state and UDim2.new(1, -3, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			AnchorPoint = Vector2.new(state and 1 or 0, 0.5),
			BackgroundColor3 = state and Theme.Window or Theme.Sub,
		})
		if o.callback then
			task.spawn(o.callback, state)
		end
	end
	function api:Get()
		return state
	end
	track.MouseButton1Click:Connect(function()
		api:Set(not state)
	end)
	return api
end

function EasyUI._Section:Button(o)
	o = o or {}
	local b = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Theme.Control,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = self._card,
	})
	corner(8, b)
	stroke(Theme.StrokeSoft, 1, 0, b)
	local l = label(o.text or "Button", 13, Theme.Text, Theme.Font, b)
	l.Size = UDim2.fromScale(1, 1)
	l.TextXAlignment = Enum.TextXAlignment.Center
	hoverable(b, Theme.Control, Theme.Hover)
	b.MouseButton1Click:Connect(function()
		ripple(b)
		if o.callback then
			task.spawn(o.callback)
		end
	end)
	return b
end

function EasyUI._Section:Slider(o)
	o = o or {}
	local min, max = o.min or 0, o.max or 100
	local step = o.step or 1
	local decimals = o.decimals or 0
	local value = math.clamp(o.default or min, min, max)

	local r = row(self._card, 40)
	local l = label(o.text or "Slider", 13, Theme.Text, Theme.Font, r)
	l.Size = UDim2.new(1, -60, 0, 18)
	local val = label(tostring(value), 12, Theme.Sub, Theme.FontMono, r)
	val.Size = UDim2.new(0, 60, 0, 18)
	val.Position = UDim2.new(1, -60, 0, 0)
	val.TextXAlignment = Enum.TextXAlignment.Right

	local track = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 0, 28),
		BackgroundColor3 = Theme.Control,
		BorderSizePixel = 0,
		Parent = r,
	})
	corner(999, track)
	local fill = new("Frame", {
		Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = track,
	})
	corner(999, fill)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(12, 12),
		Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = track,
	})
	corner(999, knob)
	stroke(Theme.StrokeSoft, 1, 0, knob)

	local function fmt(v)
		if decimals > 0 then
			return string.format("%." .. decimals .. "f", v)
		end
		return tostring(math.floor(v + 0.5))
	end

	local api = {}
	local function apply(v, animate)
		value = math.clamp(v, min, max)
		value = math.floor(value / step + 0.5) * step
		value = math.clamp(value, min, max)
		local a = (value - min) / (max - min)
		local info = animate and E.Fast or TweenInfo.new(0.03, Enum.EasingStyle.Linear)
		tw(fill, info, { Size = UDim2.new(a, 0, 1, 0) })
		tw(knob, info, { Position = UDim2.new(a, 0, 0.5, 0) })
		val.Text = fmt(value)
		if o.callback then
			task.spawn(o.callback, value)
		end
	end
	function api:Set(v)
		apply(v, true)
	end
	function api:Get()
		return value
	end

	local dragging = false
	local function fromX(px)
		local a = math.clamp((px - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		apply(min + a * (max - min), false)
	end
	track.MouseButton1Down:Connect(function()
		dragging = true
		fromX(UserInput:GetMouseLocation().X)
	end)
	UserInput.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInput.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fromX(UserInput:GetMouseLocation().X)
		end
	end)
	return api
end

function EasyUI._Section:Dropdown(o)
	o = o or {}
	local items = o.options or {}
	local value = o.default or items[1]
	local open = false

	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = self._card,
	})
	local head = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Theme.Control,
		BorderSizePixel = 0,
		Parent = holder,
	})
	corner(8, head)
	stroke(Theme.StrokeSoft, 1, 0, head)
	local l = label((o.text and o.text .. ":  " or "") .. tostring(value), 13, Theme.Text, Theme.Font, head)
	l.Position = UDim2.new(0, 10, 0, 0)
	l.Size = UDim2.new(1, -34, 1, 0)
	local arrow = label("▾", 12, Theme.Sub, Theme.Font, head)
	arrow.Position = UDim2.new(1, -22, 0, 0)
	arrow.Size = UDim2.fromOffset(16, 30)
	arrow.TextXAlignment = Enum.TextXAlignment.Center

	local body = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		Position = UDim2.new(0, 0, 0, 34),
		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = holder,
	})
	corner(8, body)
	stroke(Theme.StrokeSoft, 1, 0, body)
	pad(4, body)
	list(body, 3)

	local api = {}
	function api:Get()
		return value
	end
	function api:Set(v)
		value = v
		l.Text = (o.text and o.text .. ":  " or "") .. tostring(value)
		if o.callback then
			task.spawn(o.callback, value)
		end
	end

	local function rebuild()
		for _, c in ipairs(body:GetChildren()) do
			if c:IsA("TextButton") then
				c:Destroy()
			end
		end
		for _, it in ipairs(items) do
			local opt = new("TextButton", {
				Text = "",
				AutoButtonColor = false,
				Size = UDim2.new(1, 0, 0, 26),
				BackgroundColor3 = Theme.Control,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Parent = body,
			})
			corner(6, opt)
			local ol = label(tostring(it), 12, it == value and Theme.Text or Theme.Sub, Theme.Font, opt)
			ol.Position = UDim2.new(0, 8, 0, 0)
			ol.Size = UDim2.new(1, -8, 1, 0)
			opt.MouseEnter:Connect(function()
				tw(opt, E.Fast, { BackgroundTransparency = 0, BackgroundColor3 = Theme.Hover })
			end)
			opt.MouseLeave:Connect(function()
				tw(opt, E.Fast, { BackgroundTransparency = 1 })
			end)
			opt.MouseButton1Click:Connect(function()
				api:Set(it)
				open = false
				body.Visible = false
				tw(arrow, E.Fast, { Rotation = 0 })
				rebuild()
			end)
		end
	end

	head.MouseButton1Click:Connect(function()
		open = not open
		if open then
			rebuild()
			body.Visible = true
			tw(arrow, E.Fast, { Rotation = 180 })
		else
			body.Visible = false
			tw(arrow, E.Fast, { Rotation = 0 })
		end
	end)
	hoverable(head, Theme.Control, Theme.Hover)
	function api:SetItems(t)
		items = t
		rebuild()
	end
	return api
end

function EasyUI._Section:Keybind(o)
	o = o or {}
	local key = o.default
	local capturing = false
	local r = row(self._card, 28)
	local l = label(o.text or "Keybind", 13, Theme.Text, Theme.Font, r)
	l.Size = UDim2.new(1, -80, 1, 0)
	local b = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(76, 24),
		Position = UDim2.new(1, 0, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = Theme.Control,
		BorderSizePixel = 0,
		Parent = r,
	})
	corner(7, b)
	stroke(Theme.StrokeSoft, 1, 0, b)
	local bl = label(key and key.Name or "None", 12, Theme.Sub, Theme.FontMono, b)
	bl.Size = UDim2.fromScale(1, 1)
	bl.TextXAlignment = Enum.TextXAlignment.Center

	b.MouseButton1Click:Connect(function()
		capturing = true
		bl.Text = "..."
		tw(b, E.Fast, { BackgroundColor3 = Theme.Hover })
	end)
	UserInput.InputBegan:Connect(function(i, gp)
		if capturing and not gp then
			capturing = false
			tw(b, E.Fast, { BackgroundColor3 = Theme.Control })
			if i.KeyCode == Enum.KeyCode.Escape then
				key = nil
				bl.Text = "None"
			elseif i.KeyCode ~= Enum.KeyCode.Unknown then
				key = i.KeyCode
				bl.Text = key.Name
			end
			return
		end
		if key and not gp and i.KeyCode == key and o.callback then
			task.spawn(o.callback, key)
		end
	end)
	return { Get = function() return key end }
end

