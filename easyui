function EasyUI._Section:Colorpicker(o)
	o = o or {}
	local color = o.default or Theme.Accent
	local r = row(self._card, 28)
	local l = label(o.text or "Color", 13, Theme.Text, Theme.Font, r)
	l.Size = UDim2.new(1, -40, 1, 0)
	local swatch = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.fromOffset(34, 20),
		Position = UDim2.new(1, 0, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = r,
	})
	corner(6, swatch)
	stroke(Theme.StrokeSoft, 1, 0, swatch)

	-- minimalist hue+value popup
	local pop = new("Frame", {
		Size = UDim2.fromOffset(180, 150),
		Position = UDim2.new(1, 0, 1, 6),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Theme.Card,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 30,
		Parent = swatch,
	})
	corner(8, pop)
	stroke(Theme.Stroke, 1, 0, pop)
	pad(8, pop)
	local sat = new("ImageButton", {
		Size = UDim2.new(1, 0, 1, -28),
		BackgroundColor3 = Color3.fromHSV(0, 1, 1),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		ZIndex = 31,
		Parent = pop,
	})
	corner(6, sat)
	new("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.new(1, 1, 1)), Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }), Parent = sat })
	local satDark = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 31, Parent = sat })
	corner(6, satDark)
	new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }), Parent = satDark })
	local hueBar = new("ImageButton", {
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 1, -20),
		BorderSizePixel = 0,
		AutoButtonColor = false,
		ZIndex = 31,
		Parent = pop,
	})
	corner(6, hueBar)
	new("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
			ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
			ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
			ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
			ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)),
			ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
		}),
		Parent = hueBar,
	})

	local h, s, v = Color3.toHSV(color)
	local function refresh()
		color = Color3.fromHSV(h, s, v)
		swatch.BackgroundColor3 = color
		sat.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		if o.callback then
			task.spawn(o.callback, color)
		end
	end
	local draggingSat, draggingHue
	sat.MouseButton1Down:Connect(function() draggingSat = true end)
	hueBar.MouseButton1Down:Connect(function() draggingHue = true end)
	UserInput.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			draggingSat, draggingHue = false, false
		end
	end)
	UserInput.InputChanged:Connect(function(i)
		if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
		local m = UserInput:GetMouseLocation()
		if draggingSat then
			s = math.clamp((m.X - sat.AbsolutePosition.X) / sat.AbsoluteSize.X, 0, 1)
			v = 1 - math.clamp((m.Y - sat.AbsolutePosition.Y) / sat.AbsoluteSize.Y, 0, 1)
			refresh()
		elseif draggingHue then
			h = math.clamp((m.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
			refresh()
		end
	end)

	swatch.MouseButton1Click:Connect(function()
		pop.Visible = not pop.Visible
	end)
	return { Get = function() return color end, Set = function(_, c) h, s, v = Color3.toHSV(c); refresh() end }
end

--==================================================================
-- Toasts / notifications
--==================================================================
function EasyUI:Notify(o)
	o = o or {}
	local dur = o.duration or 4
	local kindColor = ({ ok = Theme.Good, warn = Theme.Warn, error = Theme.Bad })[o.kind] or Theme.Accent

	if not self._toastHolder then
		self._toastHolder = new("Frame", {
			Size = UDim2.new(0, 280, 1, -32),
			Position = UDim2.new(1, -16, 1, -16),
			AnchorPoint = Vector2.new(1, 1),
			BackgroundTransparency = 1,
			Parent = self.gui,
		})
		local ll = list(self._toastHolder, 8)
		ll.VerticalAlignment = Enum.VerticalAlignment.Bottom
		ll.HorizontalAlignment = Enum.HorizontalAlignment.Right
	end

	local card = new("Frame", {
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Position = UDim2.new(1, 300, 0, 0),
		Parent = self._toastHolder,
	})
	corner(10, card)
	stroke(Theme.Stroke, 1, 0.05, card)
	pad(10, card, 14, 10, 12, 10)
	local accentBar = new("Frame", {
		Size = UDim2.new(0, 3, 1, -16),
		Position = UDim2.new(0, 4, 0, 8),
		BackgroundColor3 = kindColor,
		BorderSizePixel = 0,
		Parent = card,
	})
	corner(999, accentBar)
	local t = label(o.title or "Notice", 13, Theme.Text, Theme.FontBold, card)
	t.Position = UDim2.new(0, 6, 0, 0)
	t.Size = UDim2.new(1, -6, 0, 18)
	local msg = label(o.text or "", 12, Theme.Sub, Theme.Font, card)
	msg.Position = UDim2.new(0, 6, 0, 18)
	msg.Size = UDim2.new(1, -6, 0, 16)
	msg.TextWrapped = true
	local prog = new("Frame", {
		Size = UDim2.new(1, -12, 0, 2),
		Position = UDim2.new(0, 6, 1, -6),
		BackgroundColor3 = kindColor,
		BackgroundTransparency = 0.3,
		BorderSizePixel = 0,
		Parent = card,
	})
	corner(999, prog)

	tw(card, E.Pop, { Position = UDim2.new(1, 0, 0, 0) })
	tw(prog, TweenInfo.new(dur, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) })
	task.delay(dur, function()
		local out = tw(card, E.Smooth, { Position = UDim2.new(1, 320, 0, 0), BackgroundTransparency = 1 })
		out.Completed:Connect(function()
			card:Destroy()
		end)
	end)
end

--==================================================================
-- ESP Preview (viewport with a rig + overlay box)
--==================================================================
function EasyUI:ESPPreview(opts)
	opts = opts or {}
	local w, h = 220, 300
	local win = new("Frame", {
		Size = UDim2.fromOffset(w, h),
		Position = UDim2.new(0.5, 200, 0.5, -h / 2),
		BackgroundColor3 = Theme.Window,
		BorderSizePixel = 0,
		Parent = self.gui,
	})
	corner(12, win)
	stroke(Theme.Stroke, 1, 0.2, win)
	local bar = new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Parent = win })
	draggable(bar, win)
	local t = label((self.title or "EasyUI") .. " — ESP Preview", 12, Theme.Sub, Theme.FontMono, bar)
	t.Position = UDim2.new(0, 14, 0, 0)
	t.Size = UDim2.new(1, -20, 1, 0)

	local vpHolder = new("Frame", {
		Size = UDim2.new(1, -20, 1, -46),
		Position = UDim2.new(0, 10, 0, 38),
		BackgroundColor3 = Color3.fromRGB(10, 10, 12),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Parent = win,
	})
	corner(10, vpHolder)
	stroke(Theme.StrokeSoft, 1, 0, vpHolder)

	local vp = new("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(200, 200, 200),
		LightColor = Color3.fromRGB(255, 255, 255),
		Parent = vpHolder,
	})
	local cam = new("Camera", { Parent = vp })
	vp.CurrentCamera = cam

	-- simple blocky avatar
	local model = new("Model", { Parent = vp })
	local function part(size, pos, color)
		local p = new("Part", {
			Size = size,
			Color = color or Color3.fromRGB(210, 210, 215),
			Material = Enum.Material.SmoothPlastic,
			Anchored = true,
			CanCollide = false,
			Parent = model,
		})
		p.CFrame = CFrame.new(pos)
		return p
	end
	local torso = part(Vector3.new(2, 2, 1), Vector3.new(0, 0, 0), Color3.fromRGB(225, 205, 215))
	part(Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 1.7, 0), Color3.fromRGB(240, 225, 230)) -- head
	part(Vector3.new(0.8, 2, 0.8), Vector3.new(-1.4, 0, 0)) -- arm L
	part(Vector3.new(0.8, 2, 0.8), Vector3.new(1.4, 0, 0)) -- arm R
	part(Vector3.new(0.9, 2, 0.9), Vector3.new(-0.5, -2, 0), Color3.fromRGB(60, 60, 66)) -- leg L
	part(Vector3.new(0.9, 2, 0.9), Vector3.new(0.5, -2, 0), Color3.fromRGB(60, 60, 66)) -- leg R
	model.PrimaryPart = torso

	-- overlay ESP box + name + healthbar
	local box = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(76, 150),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = vpHolder,
	})
	stroke(Theme.Accent, 1.5, 0, box)
	corner(3, box)
	local name = label("Player", 11, Theme.Text, Theme.FontBold, vpHolder)
	name.Size = UDim2.fromOffset(120, 14)
	name.AnchorPoint = Vector2.new(0.5, 1)
	name.TextXAlignment = Enum.TextXAlignment.Center
	local hp = new("Frame", {
		Size = UDim2.fromOffset(3, 150),
		BackgroundColor3 = Theme.Good,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Parent = vpHolder,
	})
	corner(999, hp)

	-- animate rotation + keep overlay glued to the box, breathe the hp bar
	local angle = 0
	RunService.RenderStepped:Connect(function(dt)
		if not vp.Parent then
			return
		end
		angle += dt * 0.6
		model:SetPrimaryPartCFrame(CFrame.new(0, 0, 0) * CFrame.Angles(0, angle, 0))
		cam.CFrame = CFrame.new(Vector3.new(0, 0.2, 8), Vector3.new(0, -0.2, 0))
		local by = box.AbsoluteSize
		name.Position = UDim2.fromOffset(
			box.AbsolutePosition.X - vpHolder.AbsolutePosition.X + by.X / 2,
			box.AbsolutePosition.Y - vpHolder.AbsolutePosition.Y - 2
		)
		hp.Position = UDim2.fromOffset(
			box.AbsolutePosition.X - vpHolder.AbsolutePosition.X - 4,
			box.AbsolutePosition.Y - vpHolder.AbsolutePosition.Y + by.Y / 2
		)
		local pct = (math.sin(angle * 1.5) * 0.5 + 0.5)
		hp.Size = UDim2.fromOffset(3, by.Y)
		hp.BackgroundColor3 = Theme.Bad:Lerp(Theme.Good, pct)
	end)

	return win
end

--==================================================================
-- DEMO — runs on execute
--==================================================================
local function demo()
	local UI = EasyUI.new({ title = "EasyUI", toggleKey = Enum.KeyCode.RightShift })

	-- Aiming
	do
		local tab = UI:Tab("Aiming")
		local aim = tab:Section("Aimbot")
		aim:Toggle({ text = "Enabled", default = true, callback = function() end })
		aim:Dropdown({ text = "Hit Part", options = { "Head", "Torso", "Nearest" }, default = "Head" })
		aim:Slider({ text = "Smoothing", min = 0, max = 100, default = 45 })
		aim:Slider({ text = "FOV", min = 0, max = 500, default = 120 })
		aim:Keybind({ text = "Aim Key", default = Enum.KeyCode.E })
		local extra = tab:Section("Prediction")
		extra:Toggle({ text = "Resolver" })
		extra:Slider({ text = "Bullet Drop", min = 0, max = 5, step = 0.05, decimals = 2, default = 1.2 })
	end

	-- Visuals
	do
		local tab = UI:Tab("Visuals")
		local box = tab:Section("Players")
		box:Toggle({ text = "Box ESP", default = true })
		box:Toggle({ text = "Name" })
		box:Toggle({ text = "Health Bar", default = true })
		box:Toggle({ text = "Skeleton" })
		box:Colorpicker({ text = "Box Color", default = Color3.fromRGB(236, 236, 240) })
		local ch = tab:Section("Chams")
		ch:Toggle({ text = "Enabled" })
		ch:Dropdown({ text = "Material", options = { "ForceField", "Neon", "Glass" }, default = "ForceField" })
		ch:Colorpicker({ text = "Fill", default = Color3.fromRGB(240, 190, 210) })
	end

	-- World
	do
		local tab = UI:Tab("World")
		local w = tab:Section("Environment")
		w:Toggle({ text = "Fullbright" })
		w:Slider({ text = "Brightness", min = 0, max = 5, step = 0.1, decimals = 1, default = 2 })
		w:Toggle({ text = "No Fog", default = true })
		w:Textbox({ text = "Waypoint", placeholder = "name..." })
		w:Button({ text = "Create Waypoint", callback = function()
			UI:Notify({ title = "Waypoint", text = "Saved current position", kind = "ok" })
		end })
	end

	-- Config
	do
		local tab = UI:Tab("Config")
		local c = tab:Section("Theme")
		c:Colorpicker({ text = "Accent", default = Theme.Accent, callback = function(col)
			Theme.Accent = col
		end })
		c:Slider({ text = "UI Scale", min = 80, max = 120, default = 100 })
		local a = tab:Section("Actions")
		a:Button({ text = "Notify Test", callback = function()
			UI:Notify({ title = "EasyUI", text = "This is a toast notification.", kind = "ok" })
		end })
		a:Button({ text = "Warn Test", callback = function()
			UI:Notify({ title = "Careful", text = "Something might be off.", kind = "warn" })
		end })
	end

	UI:ESPPreview()
	task.delay(0.4, function()
		UI:Notify({ title = "EasyUI", text = "UI loaded. Press RightShift to toggle.", kind = "ok", duration = 5 })
	end)

	return UI
end

demo()
