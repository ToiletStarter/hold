function Bridge.Detach(ui)
    local old
    if ui ~= nil then
        old = ui._espBridge
    else
        old = Runtime.bridge
    end
    if not old then
        return false
    end
    if old.unsub then
        for i = #old.unsub, 1, -1 do
            local fn = old.unsub[i]
            old.unsub[i] = nil
            pcall(fn)
        end
    end
    if old.windows then
        for i = #old.windows, 1, -1 do
            local w = old.windows[i]
            old.windows[i] = nil
            if w then
                w:Destroy()
            end
        end
    end
    if old.prefix and old.ui then
        old.ui:Unmount(old.prefix)
    end
    if old.ui then
        old.ui:Set("bridge.esp", nil)
        old.ui._espBridge = nil
    end
    if Runtime.bridge == old then
        Runtime.bridge = nil
    end
    return true
end

local function bridgeMethods(link)
    function link:sync()
        self.ui:Sync(self.prefix)
    end

    function link:applyTheme()
        local theme = self.ui:Get("bridge.theme", self.ui:GetThemeName())
        local accent = self.ui:Get("bridge.accent")
        self.ui:SetTheme(theme)
        if accent then
            self.ui:SetAccent(accent)
        end
        if self.esp and self.esp.theme then
            self.esp:theme(theme)
            if accent and self.esp.setAccent then
                self.esp:setAccent(accent)
            end
        end
        self:sync()
    end

    function link:applySetup()
        if not self.esp then return false end
        local preset = self.ui:Get("bridge.preset")
        local profile = self.ui:Get("bridge.profile")
        local pack = self.ui:Get("bridge.pack")
        if preset and preset ~= "" and self.esp.preset then
            self.esp:preset(preset)
        else
            if profile and self.esp.profile then self.esp:profile(profile) end
            if pack and self.esp.pack then self.esp:pack(pack) end
        end
        self:sync()
        return true
    end

    function link:save(name)
        name = name or self.ui:Get("bridge.cfgName", "default")
        local ok0 = self.ui:SaveConfig(name)
        local ok1 = self.esp and self.esp.save and self.esp:save(name)
        self.ui:Toast("Config", "Saved " .. tostring(name), 1.8, ok0 and ok1 ~= false and "ok" or "warn")
        return ok0, ok1
    end

    function link:load(name)
        name = name or self.ui:Get("bridge.cfgName", "default")
        local ok0 = self.ui:LoadConfig(name)
        local ok1 = self.esp and self.esp.load and self.esp:load(name)
        self:applyTheme()
        self:sync()
        self.ui:Toast("Config", "Loaded " .. tostring(name), 1.8, ok0 and ok1 ~= false and "ok" or "warn")
        return ok0, ok1
    end

    function link:detach()
        return Bridge.Detach(self.ui)
    end

    return link
end

function Bridge.Attach(ui, esp, opt)
    opt = opt or {}
    Bridge.Detach(ui)
    if Runtime.bridge and Runtime.bridge.ui ~= ui then
        Bridge.Detach(Runtime.bridge.ui)
    end

    local prefix = clean(opt.prefix or "esp")
    ui:Mount(prefix, esp.cfg)
    ui:Set("bridge.esp", esp)
    local themeObj = ui:GetTheme() or ui.theme
    ui:Set("bridge.theme", ui:GetThemeName())
    ui:Set("bridge.accent", themeObj and themeObj.accent or nil)
    ui:Set("bridge.profile", opt.profile or "balanced")
    ui:Set("bridge.pack", opt.pack or "clean")
    ui:Set("bridge.preset", opt.preset or "legit")
    ui:Set("bridge.cfgName", opt.cfgName or "default")

    local wins = ui:Build(opt.schema or Bridge.Schema(prefix))
    local link = bridgeMethods({
        ui = ui,
        esp = esp,
        prefix = prefix,
        windows = wins,
        unsub = {},
    })

    if opt.liveTheme then
        link.unsub[#link.unsub + 1] = ui:Watch("bridge.theme", function()
            link:applyTheme()
        end, false)
        link.unsub[#link.unsub + 1] = ui:Watch("bridge.accent", function()
            link:applyTheme()
        end, false)
    end

    ui._espBridge = link
    Runtime.bridge = link
    link:sync()
    return link
end

function Bridge.ApplyTheme(link)
    if link and link.applyTheme then
        return link:applyTheme()
    end
end

function Bridge.ApplySetup(link)
    if link and link.applySetup then
        return link:applySetup()
    end
end

function Bridge.Save(link, name)
    if link and link.save then
        return link:save(name)
    end
end

function Bridge.Load(link, name)
    if link and link.load then
        return link:load(name)
    end
end

Bridge.Toolkit = {
    Schema = function(prefix) return Bridge.Schema(prefix) end,
    Attach = function(ui, esp, opt) return Bridge.Attach(ui, esp, opt) end,
    Detach = function(ui) return Bridge.Detach(ui) end,
    ApplyTheme = function(link) return Bridge.ApplyTheme(link) end,
    ApplySetup = function(link) return Bridge.ApplySetup(link) end,
    Save = function(link, name) return Bridge.Save(link, name) end,
    Load = function(link, name) return Bridge.Load(link, name) end,
    Pair = function(UIMod, ESPMod, uiOpt, espOpt, bridgeOpt)
        uiOpt = uiOpt or {}
        espOpt = espOpt or {}
        bridgeOpt = bridgeOpt or {}
        local ui = UIMod.new(uiOpt)
        local esp = ESPMod.new(espOpt)
        if esp.on and espOpt.on ~= false then esp:on(true) end
        if esp.start and bridgeOpt.start ~= false then esp:start() end
        local link = Bridge.Attach(ui, esp, bridgeOpt)
        return ui, esp, link
    end,
}

return Bridge
